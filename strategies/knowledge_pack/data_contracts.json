{
  "schema_version": "2.0.0",
  "purpose": "Language-neutral domain contracts; field lists and invariants are requirements, not an exchange API or an executable JSON Schema for market events.",
  "global_conventions": {
    "timestamps": "UTC ISO-8601 with subsecond precision plus original venue timestamp and unit where needed",
    "calendar_timezones": "IANA timezone IDs; never fixed UTC offsets for exchange sessions",
    "money_and_quantity": "Decimal strings or fixed-point integers with declared scale; no silent float rounding",
    "unknown_values": "null plus explicit reason; never silently replace with 0",
    "provenance": "source/feed ID, received time, schema version and immutable raw reference",
    "identifiers": "Stable internal IDs; venue symbols are versioned aliases",
    "chain_identity": "Namespace/network plus deployment address or mint; native assets have explicit native identity, never an invented token contract.",
    "observation_order": "Preserve block/slot, transaction index, instruction/log index, commitment, and received_at. A wall-clock block timestamp may be null or coarse.",
    "economic_flow": "Distinguish swaps, internal router hops, transfers, mints, burns, liquidity operations, funding, rebates, and fees."
  },
