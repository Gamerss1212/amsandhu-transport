 "definition": {
  "name": "Hammer / shooting star at prior-session level",
  "family": "candlestick",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "candle().hammer == 1 and abs(low - session().prev_low) < 0.2*atr(14)",
   "short": "candle().shooting_star == 1 and abs(high - session().prev_high) < 0.2*atr(14)"
  },
  "filters": [],
  "order": {
   "type": "market"
  },
