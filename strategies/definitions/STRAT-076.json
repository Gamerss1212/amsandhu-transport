 "key": "pin_bar_at_level",
 "name": "Hammer / shooting star at prior-session level",
 "family": "candlestick",
 "subfamily": "rejection candle",
 "hypothesis": "A hammer whose low tests yesterday's low (within 0.2 ATR) shows rejection of lower prices.",
 "markets": [
  "stock",
  "crypto"
 ],
 "timeframe": "5m",
 "data": [
