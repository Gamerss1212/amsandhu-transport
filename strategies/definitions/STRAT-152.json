 "key": "elder_triple_screen",
 "name": "Triple Screen (Elder)",
 "family": "named_systems",
 "subfamily": "multi-timeframe",
 "hypothesis": "When the hourly MACD histogram is rising, buy 5-minute pullbacks (2-period force index below zero) with a buy stop above the prior bar.",
 "markets": [
  "stock",
  "crypto"
 ],
 "timeframe": "5m",
 "data": [
  "bars"
 ],
 "definition": {
  "name": "Triple Screen (Elder)",
  "family": "named_systems",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "tf(\"1h\", macd(close,12,26,9).hist > macd(close,12,26,9).hist[1]) == 1 and force(2) < 0",
   "short": "tf(\"1h\", macd(close,12,26,9).hist < macd(close,12,26,9).hist[1]) == 1 and force(2) > 0"
  },
  "filters": [],
  "order": {
   "type": "stop",
   "long": "high",
   "short": "low",
   "ttl_bars": 2
  },
  "stop": {
   "type": "level",
   "long": "lowest(low,3)",
   "short": "highest(high,3)"
  },
  "target": {
   "type": "r",
   "r": 2.0
  },
  "trail": {
   "type": "none"
  },
  "exit": {},
