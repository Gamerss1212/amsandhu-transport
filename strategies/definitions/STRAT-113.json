  "family": "crypto_structure",
  "timeframe": "15m",
  "direction": "both",
  "params": {},
  "entry": {
   "short": "dow() == 0 and weekend(21,23).gap > 0.01 and close > weekend(21,23).fri_close and close < open",
   "long": "dow() == 0 and weekend(21,23).gap < -0.01 and close < weekend(21,23).fri_close and close > open"
