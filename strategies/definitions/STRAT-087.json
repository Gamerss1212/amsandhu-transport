{
 "id": "STRAT-087",
 "key": "range_box_reversion",
 "name": "Choppy-regime range trading",
 "family": "market_structure",
 "subfamily": "range",
 "hypothesis": "When the Choppiness Index is above 61.8, buy near the 20-bar low and sell near the 20-bar high.",
 "markets": [
  "stock",
  "crypto"
 ],
 "timeframe": "5m",
 "data": [
  "bars"
 ],
 "definition": {
  "name": "Choppy-regime range trading",
  "family": "market_structure",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "chop(14) > 61.8 and low <= lowest(low,20)[1] + 0.1*atr(14) and close > open",
   "short": "chop(14) > 61.8 and high >= highest(high,20)[1] - 0.1*atr(14) and close < open"
  },
  "filters": [],
  "order": {
   "type": "market"
  },
  "stop": {
   "type": "atr",
   "mult": 1.0,
   "n": 14
  },
  "target": {
   "type": "level",
   "long": "(highest(high,20) + lowest(low,20))/2",
   "short": "(highest(high,20) + lowest(low,20))/2"
  },
  "trail": {
   "type": "none"
  },
  "exit": {},
  "max_bars": 0,
  "session": {
   "stock": {
    "entry_start": "09:35",
    "entry_end": "15:30",
    "flat_minutes_before_close": 5
   },
