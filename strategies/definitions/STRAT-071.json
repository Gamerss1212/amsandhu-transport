{
 "id": "STRAT-071",
 "key": "bb_squeeze_breakout",
 "name": "Bollinger squeeze breakout",
 "family": "volatility",
 "subfamily": "compression",
 "hypothesis": "When Bollinger bandwidth is near its 120-bar low, the next close outside the bands starts an expansion move.",
 "markets": [
  "stock",
  "crypto"
 ],
 "timeframe": "5m",
 "data": [
  "bars"
 ],
 "definition": {
  "name": "Bollinger squeeze breakout",
  "family": "volatility",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "within(bb(close,20,2).width <= 1.1*lowest(bb(close,20,2).width, 120), 6) and cross_above(close, bb(close,20,2).upper)",
   "short": "within(bb(close,20,2).width <= 1.1*lowest(bb(close,20,2).width, 120), 6) and cross_below(close, bb(close,20,2).lower)"
  },
  "filters": [],
  "order": {
   "type": "market"
  },
  "stop": {
   "type": "level",
   "long": "bb(close,20,2).mid",
   "short": "bb(close,20,2).mid"
  },
  "target": {
   "type": "r",
   "r": 2.0
  },
  "trail": {
   "type": "none"
  },
  "exit": {},
  "max_bars": 0,
  "session": {
