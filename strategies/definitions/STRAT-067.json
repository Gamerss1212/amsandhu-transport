 "definition": {
  "name": "Regression-channel reversion",
  "family": "mean_reversion",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "close < linreg(close,100).value - 2*std(close - linreg(close,100).value, 100) and linreg(close,100).slope >= 0",
   "short": "close > linreg(close,100).value + 2*std(close - linreg(close,100).value, 100) and linreg(close,100).slope <= 0"
  },
  "filters": [],
  "order": {
   "type": "market"
  },
  "stop": {
   "type": "atr",
   "mult": 2.0,
   "n": 14
  },
  "target": {
   "type": "level",
   "long": "linreg(close,100).value",
   "short": "linreg(close,100).value"
  },
  "trail": {
   "type": "none"
  },
  "exit": {},
  "max_bars": 0,
