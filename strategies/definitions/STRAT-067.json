 "key": "linreg_channel_reversion",
 "name": "Regression-channel reversion",
 "family": "mean_reversion",
 "subfamily": "trend line",
 "hypothesis": "A close more than two residual standard deviations below the 100-bar regression line reverts toward the line.",
 "markets": [
  "stock",
  "crypto"
 ],
 "timeframe": "5m",
 "data": [
  "bars"
