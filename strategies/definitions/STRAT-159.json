{
 "id": "STRAT-159",
 "key": "tsmom_vol_scaled",
 "name": "Volatility-normalized time-series momentum",
 "family": "trend_following",
 "subfamily": "time-series momentum",
 "hypothesis": "Enter when the 48-bar (12-hour on 15m) log return crosses one volatility unit in its direction; exit when the return changes sign or after 96 bars; 3-ATR stop.",
 "markets": [
  "stock",
  "crypto"
 ],
 "timeframe": "15m",
 "data": [
  "bars"
 ],
 "definition": {
  "name": "Volatility-normalized time-series momentum",
  "family": "trend_following",
  "timeframe": "15m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "cross_above(log(close/close[48]) / (realized_vol(48).per_bar * sqrt(48)), 1)",
   "short": "cross_below(log(close/close[48]) / (realized_vol(48).per_bar * sqrt(48)), -1)"
  },
  "filters": [],
  "order": {
   "type": "market"
  },
  "stop": {
   "type": "atr",
   "mult": 3.0,
   "n": 14
  },
  "target": {
   "type": "none"
  },
  "trail": {
   "type": "none"
  },
  "exit": {
   "long": "close < close[48]",
   "short": "close > close[48]"
  },
  "max_bars": 96,
  "session": {
   "stock": {
    "entry_start": "09:35",
    "entry_end": "15:30",
    "flat_minutes_before_close": 5
   },
   "crypto": {
    "flat_minutes_before_close": 5
   }
  },
  "max_trades_per_day": 2,
  "cooldown_bars": 0,
  "sizing": {
   "risk_pct": 0.5,
   "max_notional_pct": 100.0
  },
  "data": [
   "bars"
  ],
  "id": "STRAT-159",
  "version": "1.0.0"
 },
