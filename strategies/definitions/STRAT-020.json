{
 "id": "STRAT-020",
 "key": "orb_stocks_in_play",
 "name": "Stocks-in-play 5-minute ORB with ATR stop",
 "family": "opening_range",
 "subfamily": "opening range",
 "hypothesis": "Only when the first 5-minute bar trades at least twice its usual volume, place a stop order at that bar's high (up candle) or low (down candle); stop 10% of the 14-day ATR; exit at the close.",
 "markets": [
  "stock"
 ],
 "timeframe": "5m",
 "data": [
  "bars"
 ],
 "definition": {
  "name": "Stocks-in-play 5-minute ORB with ATR stop",
  "family": "opening_range",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "bar_in_session() == 0 and close > open and rvol_tod(14) > 2",
   "short": "bar_in_session() == 0 and close < open and rvol_tod(14) > 2"
  },
  "filters": [],
  "order": {
   "type": "stop",
   "long": "opening_range(5).high",
   "short": "opening_range(5).low",
   "ttl_bars": 70
  },
  "stop": {
   "type": "level",
   "long": "opening_range(5).high - 0.1*tf(\"1d\", atr(14))",
   "short": "opening_range(5).low + 0.1*tf(\"1d\", atr(14))"
  },
  "target": {
   "type": "none"
  },
  "trail": {
   "type": "none"
  },
  "exit": {},
  "max_bars": 0,
  "session": {
   "flat_minutes_before_close": 5
  },
  "max_trades_per_day": 1,
  "cooldown_bars": 0,
  "sizing": {
   "risk_pct": 0.5,
   "max_notional_pct": 100.0
  },
  "data": [
   "bars"
  ],
