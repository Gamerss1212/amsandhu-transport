 "key": "gap_and_go",
 "name": "Gap-and-go continuation",
 "family": "gaps",
 "subfamily": "opening gap",
 "hypothesis": "A gap of at least 1% whose first 5-minute bar closes in the gap's direction on at least 1.5x usual volume continues past that bar's extreme.",
 "markets": [
  "stock"
 ],
 "timeframe": "5m",
 "data": [
