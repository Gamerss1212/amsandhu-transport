 "name": "Ten o'clock reversal",
 "family": "reference_levels",
 "subfamily": "time-conditioned reversal",
 "hypothesis": "If the first 30 minutes moved strongly one way, a reversal bar between 10:00 and 10:30 marks the day's first swing extreme.",
 "markets": [
  "stock"
 ],
 "timeframe": "5m",
