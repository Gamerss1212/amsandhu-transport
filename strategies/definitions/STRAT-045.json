 "definition": {
  "name": "Ten o'clock reversal",
  "family": "reference_levels",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "short": "time_between(\"10:00\", \"10:30\") and valuewhen(minutes_since_open() == 25, close) / session().open - 1 > 0.004 and close < low[1]",
   "long": "time_between(\"10:00\", \"10:30\") and valuewhen(minutes_since_open() == 25, close) / session().open - 1 < -0.004 and close > high[1]"
  },
