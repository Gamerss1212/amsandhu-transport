  "family": "cross_asset",
  "timeframe": "5m",
  "direction": "both",
  "params": {
   "bench": "SPY"
  },
  "entry": {
   "long": "spread_z(close, sym($bench, close), 60) < -2",
   "short": "spread_z(close, sym($bench, close), 60) > 2"
  },
