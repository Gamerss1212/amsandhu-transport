 "name": "Beta-adjusted residual reversion",
 "family": "cross_asset",
 "subfamily": "statistical arbitrage",
 "hypothesis": "When a stock's log price minus beta times SPY's falls two standard deviations below its 60-bar mean, it reverts.",
 "markets": [
  "stock"
 ],
 "timeframe": "5m",
 "data": [
