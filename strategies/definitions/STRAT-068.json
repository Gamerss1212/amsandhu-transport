 "definition": {
  "name": "Volatility-shock bar reversal",
  "family": "mean_reversion",
  "timeframe": "5m",
  "direction": "both",
  "params": {},
  "entry": {
   "long": "high - low > 3*atr(14)[1] and close < low + 0.25*(high - low)",
   "short": "high - low > 3*atr(14)[1] and close > high - 0.25*(high - low)"
  },
  "filters": [],
