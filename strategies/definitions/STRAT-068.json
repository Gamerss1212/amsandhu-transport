 "name": "Volatility-shock bar reversal",
 "family": "mean_reversion",
 "subfamily": "range shock",
 "hypothesis": "A bar whose range exceeds 3 ATR and closes near its extreme retraces part of the move over the next bars.",
 "markets": [
  "stock",
  "crypto"
 ],
 "timeframe": "5m",
 "data": [
