# Copy this file to .env (in the same folder) and fill it in yourself. Never commit .env,
# never email it, never paste it into a chat. Claude Code is blocked from reading or editing it.
# QuantAgents reads it when it starts and never prints the values.
# Paper trading needs nothing in here.

# --- Real money (Phase 8). Read docs/REAL_MONEY.md first. ---
# Exchange keys: trade-only. Allowed: query funds, query orders and trades, create and cancel
# orders. NOT allowed: withdraw, deposit addresses, transfers. Turn on the IP allow-list.
# The exchange is the one in your symbols (BTC-CAD.KRAKEN trades on Kraken).
LIVE_API_KEY=
LIVE_API_SECRET=
# Only for exchanges that give a passphrase with the key (Kraken does not):
LIVE_API_PASSWORD=
# The approval phrase goes here too, as one more line. `quantagents live check` prints the
# exact line when everything else is ready. Leave it out and real money stays off.

# Phone alerts for real fills and halts (optional): make a bot with @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 6 (LLM agents, not used yet): set a monthly spending limit on the key
LLM_API_KEY=
