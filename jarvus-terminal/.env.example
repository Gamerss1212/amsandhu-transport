# Jarvus configuration: environment variables, all optional. Set them in the shell (or the Windows environment)
# before starting Jarvus; the app does not read this file itself. No credentials belong here: broker keys and the
# Anthropic API key are entered in the app (Connections page) and go straight into the encrypted vault.

# Port on 127.0.0.1 (the app never listens on a network interface)
JARVUS_PORT=8787

# Where accounts, workspaces, databases, backups and the research cache are kept (default: data/ beside the program)
# JARVUS_DATA=C:\Users\you\JarvusData

# Resource budgets
JARVUS_MAX_FLEETS=4              # bot engines running at once (one per workspace)
JARVUS_RESEARCH_WORKERS=0        # research worker processes; 0 = CPU cores - 1
JARVUS_JOB_TIMEOUT_S=900         # wall-clock limit per research job (seconds)
JARVUS_JOB_MEMORY_MB=1500        # memory limit per research job (MB)

# Credential vault location (default %APPDATA%\mab on Windows, ~/.config/mab elsewhere)
# MAB_SECRETS_DIR=/path/to/vault
# MAB_SECRETS_NO_KEYRING=1       # keep the vault key in an owner-only file instead of the system keyring
