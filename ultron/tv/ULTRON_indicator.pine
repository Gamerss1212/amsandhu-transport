var float[] G_MU = array.from(0.0, -0.03253478, -0.12019929, -0.23535148, -0.10365608, -0.09621157, 1.66992847, 0.98091868, -0.00085268, -0.00016234, 0.28493734, -0.20757182, -0.05559745, 0.00454604, 0.0, -0.03152474, -0.13221891, -0.22403369, -0.11333983, -0.10585087, 1.59433532, 0.98733103, -0.00061004, -0.00008791, 0.28511088, -0.23248327, -0.05388081, 0.00629933, 0.0, -0.03254975, -0.13824407, -0.21891957, -0.11637698, -0.10781968, 1.59935248, 0.98856975, -0.00017196, -0.00026739, 0.28503871, -0.25141117, -0.05492255, 0.00023166, 0.0, -0.04035717, -0.15548584, -0.19200834, -0.12993081, -0.11763269, 1.58404434, 0.98695239, 0.00001015, -0.00020117, 0.28549648, -0.28392976, -0.05989721, -0.00949292, 0.0, -0.04543881, -0.15605803, -0.17119972, -0.13011054, -0.11531542, 1.62310938, 0.98633634, -0.00022392, 0.00005496, 0.28511248, -0.2901118, -0.06104676, -0.01054739, 0.0, -0.05220553, -0.14800495, -0.15333357, -0.12981066, -0.11133826, 1.59105047, 0.98581661, -0.00003807, 0.0, 0.28563265, -0.29061335, -0.06403202, -0.00863792, 0.0, -0.06233764, -0.15130464, -0.15154518, -0.10834668, -0.11129194, 1.62585013, 0.98623463, 0.0, 1.0, 0.28557377, -0.25102215, -0.07197294, -0.03449098, 0.0, 0.01215155, -0.09425696, -0.04547471, -0.08732071, -0.07631407, 1.90403332, 0.88677536, 0.0, 1.0, 0.0, -0.19495637, -0.04308911, -0.01472761)
