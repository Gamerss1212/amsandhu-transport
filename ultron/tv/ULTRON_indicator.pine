var float[] G_WQ = array.from(-0.71350186, -1.18399871, 0.06952846, -0.06186877, 0.33857105, 0.12451232, -0.20305884, -0.12265613, 0.03006537, 0.06499053, 0.32131755, -0.02217419, 0.0946048, -0.08536985, -0.74079568, -1.15899659, 0.07755161, -0.06323477, 0.27502988, 0.23637411, -0.18305491, -0.18582265, 0.0962674, 0.28736447, 0.32157357, -0.00617539, 0.05986263, 0.09381984, -0.75271244, -1.11704907, 0.05815662, 0.00955993, 0.11722379, 0.19760617, -0.14774734, -0.17582204, 0.00583139, 0.33470721, 0.23871965, 0.02014563, 0.07704687, 0.14758509, -0.65715546, -0.7879693, -0.15809324, 0.0662735, 0.24754194, 0.18897011, -0.07079198, -0.17524815, -0.17091167, 0.24656256, 0.26754159, -0.0559487, 0.01833281, 0.04452539, -0.63702239, -0.69096014, 0.12029648, -0.05311288, 0.17960987, 0.07753753, -0.16292125, -0.15050618, -0.04361465, 0.02696867, 0.19820507, -0.06672688, -0.20289335, 0.06941506, -0.59740917, -0.4971175, 0.02682835, -0.05674631, 0.0952404, -0.08597192, -0.04081181, -0.17779639, -0.04184137, -0.02561205, -0.04885428, -0.02243451, -0.23074698, -0.02924057, -0.62051931, -0.32920627, 0.02026985, -0.12627576, 0.22307401, 0.32809408, -0.14925422, -0.23847002, 0.0, 0.0, -0.10077898, -0.08359941, -0.50684308, -0.26729686, -0.5955303, -0.2898272, -0.03770005, 0.06072607, -0.12548925, -0.26400929, 0.18613742, -0.13445751, 0.0, 0.0, 0.0, -0.09192632, -0.15568659, -0.08450543)
var float[] G_TL = array.from(0.730561, 0.685067, 0.686702, 0.621175, 0.645973, 0.628116, 0.562162, 0.668685)
var float[] G_TQ = array.from(0.68239, 0.687253, 0.676569, 0.63675, 0.62689, 0.630119, 0.599922, 0.648265)
var string[] G_PREC = array.from("81%", "72%", "74%", "80%", "83%", "87%", "29%", "80%")
useOn = array.from(u_bb_above, u_bb_below, u_bb_reentry, u_bear_engulfing, u_bear_harami, u_big_bear_bar, u_big_bull_bar, u_bull_belt_hold, u_bull_engulfing, u_bull_harami, u_bull_marubozu, u_cci_break, u_cci_up, u_dark_cloud_cover, u_doji_after_drop, u_doji_after_rise, u_donchian20, u_donchian20_down, u_donchian55, u_drop_24h, u_ema_9_21_down, u_ema_9_21_up, u_evening_star, u_five_green, u_five_red, u_ha_green, u_ha_red, u_hammer, u_hanging_man, u_holy_grail, u_inside_bar, u_inside_bar_break_down, u_inside_bar_break_up, u_inverted_hammer, u_keltner_up, u_macd_down, u_macd_hist_turn, u_macd_up, u_macd_up_below0, u_mfi_ob, u_nr7_break_up, u_obv_confirm, u_obv_lead, u_outside_bar_down, u_outside_bar_up, u_rally_24h, u_rsi2_connors, u_rsi_dn_70, u_rsi_ob_70, u_spinning_top, u_stoch_down, u_stoch_up, u_stochrsi_up, u_stretch_ema20, u_three_outside_down, u_three_outside_up, u_tweezer_bottom, u_tweezer_top, u_vol_spike_bull, u_vwap_lose, u_vwap_reclaim, u_willr_up)

// ═════════ market
base = syminfo.basecurrency
isMajor = base == "BTC" or base == "ETH" or base == "SOL"
isMeme = base == "DOGE" or base == "SHIB" or base == "PEPE" or base == "BONK" or base == "WIF" or base == "FLOKI"
useMajor = isMajor or (not isMeme and iOther)
mktKnown = syminfo.ticker == "AAPL" or syminfo.ticker == "AMD" or syminfo.ticker == "AMZN" or syminfo.ticker == "AUDUSD" or syminfo.ticker == "CNQ" or syminfo.ticker == "DIA" or syminfo.ticker == "ENB" or syminfo.ticker == "EURUSD" or syminfo.ticker == "GBPUSD" or syminfo.ticker == "GLD" or syminfo.ticker == "GOOGL" or syminfo.ticker == "IWM" or syminfo.ticker == "JPM" or syminfo.ticker == "META" or syminfo.ticker == "MSFT" or syminfo.ticker == "NFLX" or syminfo.ticker == "NVDA" or syminfo.ticker == "QQQ" or syminfo.ticker == "RY" or syminfo.ticker == "SHOP" or syminfo.ticker == "SLV" or syminfo.ticker == "SPY" or syminfo.ticker == "TD" or syminfo.ticker == "TSLA" or syminfo.ticker == "USDCAD" or syminfo.ticker == "USDJPY" or syminfo.ticker == "USO" or syminfo.ticker == "XIU"
hasMkt = true
exSel = iExit == "Auto: highest win rate that stayed profitable" ? -1 : iExit == "2R (trained)" ? 0 : iExit == "1.5R" ? 1 : iExit == "1R" ? 2 : iExit == "0.5R" ? 3 : iExit == "Half at 1R, rest 2R" ? 4 : iExit == "Half at 0.5R, rest 2R" ? 5 : 6
exK = exSel < 0 ? array.get(AUTO_K, mi) : exSel
exR = array.get(X_R, exK)
exF = array.get(X_F, exK)
exT = array.get(X_T, exK)
sK = mi * 7 + exK
mPassed = array.get(S_PASS, sK)
pass2R = array.get(S_PASS, mi * 7)
exName = array.get(X_NAME, exK)
sg3(x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.000")
wonTxt = na(array.get(S_WIN, sK)) ? "not tested" : str.tostring(array.get(S_WIN, sK), "#") + "% of trades won · " + sg3(array.get(S_AVG, sK)) + "R avg" + (na(array.get(S_TWIN, sK)) ? "" : " (test since Dec 2025: " + str.tostring(array.get(S_TWIN, sK), "#") + "% · " + sg3(array.get(S_TAVG, sK)) + "R, " + str.tostring(array.get(S_TN, sK)) + " trades)")
active = (isMarket ? hasMkt and (mktKnown or iOther) and exact : (isMajor or isMeme or iOther) and (exact or iNearest)) and (mPassed or not iOnlyPassed)
slip = useMajor or isMarket ? 0.0002 : 0.001

// ═════════ the 62 signals the councils use (same formulas on the chart and on the higher timeframe)
f_dn(k) => close[k + 1] < close[k + 6]
f_up(k) => close[k + 1] > close[k + 6]
f_all(bd) =>
    A = ta.atr(14)
    body = math.abs(close - open)
    rng = high - low
    upw = high - math.max(open, close)
    loww = math.min(open, close) - low
    isBull = close > open
    isBear = close < open
    big = rng >= 0.5 * A
    ham = loww >= 2 * body and upw <= 0.1 * rng and body >= 0.05 * rng and big
    inv = upw >= 2 * body and loww <= 0.1 * rng and body >= 0.05 * rng and big
    doji = body <= 0.1 * rng and big
    ins = high < high[1] and low > low[1]
    nr7 = rng <= ta.lowest(rng, 7)
    engUp = isBear[1] and isBull and close >= open[1] and open <= close[1] and body > body[1]
    engDn = isBull[1] and isBear and close <= open[1] and open >= close[1] and body > body[1]
    bullEng = f_dn(1) and engUp
    bearEng = f_up(1) and engDn
    bigRed1 = isBear[1] and body[1] >= 0.6 * rng[1] and body[1] >= 0.75 * A[1]
    bigGrn1 = isBull[1] and body[1] >= 0.6 * rng[1] and body[1] >= 0.75 * A[1]
    harUp = bigRed1 and math.max(open, close) <= open[1] and math.min(open, close) >= close[1] and body <= 0.5 * body[1]
    harDn = bigGrn1 and math.max(open, close) <= close[1] and math.min(open, close) >= open[1] and body <= 0.5 * body[1]
    bullHar = f_dn(1) and harUp and isBull
    bearHar = f_up(1) and harDn and isBear
    bigRed2 = isBear[2] and body[2] >= 0.6 * rng[2] and body[2] >= 0.75 * A[2]
    bigGrn2 = isBull[2] and body[2] >= 0.6 * rng[2] and body[2] >= 0.75 * A[2]
    mStar = f_dn(2) and bigRed2 and body[1] <= 0.3 * body[2] and isBull and close > (open[2] + close[2]) / 2
    eStar = f_up(2) and bigGrn2 and body[1] <= 0.3 * body[2] and isBear and close < (open[2] + close[2]) / 2
    sold = isBull and body >= 0.6 * rng and body >= 0.5 * A and upw <= 0.3 * body
    crow = isBear and body >= 0.6 * rng and body >= 0.5 * A
    tws = sold and sold[1] and sold[2] and close > close[1] and close[1] > close[2] and open >= open[1] and open <= close[1] and open[1] >= open[2] and open[1] <= close[2]
    tbc = crow and crow[1] and crow[2] and close < close[1] and close[1] < close[2] and open <= open[1] and open >= close[1] and open[1] <= open[2] and open[1] >= close[2]
    small3 = body[1] <= 0.5 * body[4] and high[1] <= high[4] and low[1] >= low[4] and body[2] <= 0.5 * body[4] and high[2] <= high[4] and low[2] >= low[4] and body[3] <= 0.5 * body[4] and high[3] <= high[4] and low[3] >= low[4]
    g5 = isBull and isBull[1] and isBull[2] and isBull[3] and isBull[4]
    r5 = isBear and isBear[1] and isBear[2] and isBear[3] and isBear[4]
    rsi14 = ta.rsi(close, 14)
    rsi2 = ta.rsi(close, 2)
    sma50 = ta.sma(close, 50)
    sma200 = ta.sma(close, 200)
    e9 = ta.ema(close, 9)
    e20 = ta.ema(close, 20)
    e21 = ta.ema(close, 21)
    e200 = ta.ema(close, 200)
    macdL = ta.ema(close, 12) - ta.ema(close, 26)
    sigL = ta.ema(macdL, 9)
    hist = macdL - sigL
    macdUp = macdL > sigL and macdL[1] <= sigL[1]
    bbB = ta.sma(close, 20)
    bbD = ta.stdev(close, 20)
    bbU = bbB + 2 * bbD
    bbL = bbB - 2 * bbD
    bw = (bbU - bbL) / bbB
    kcU = e20 + 2 * A
    kcL = e20 - 2 * A
    sq = bbU < kcU and bbL > kcL
    stK = ta.sma(ta.stoch(close, high, low, 14), 3)
    stD = ta.sma(stK, 3)
    srs = (rsi14 - ta.lowest(rsi14, 14)) / (ta.highest(rsi14, 14) - ta.lowest(rsi14, 14))
    srK = ta.sma(srs, 3)
    srD = ta.sma(srK, 3)
    wr = -100 * (ta.highest(high, 14) - close) / (ta.highest(high, 14) - ta.lowest(low, 14))
    cciV = ta.cci(hlc3, 20)
    mf = ta.mfi(hlc3, 14)
    [diP, diM, adxV] = ta.dmi(14, 14)
    don20 = close > ta.highest(high, 20)[1]
    don55 = close > ta.highest(high, 55)[1]
    dd20 = close < ta.lowest(low, 20)[1]
    ob = ta.obv
    obvHi = ob >= ta.highest(ob, 20)[1]
    cHi = close >= ta.highest(close, 20)[1]
    obvLead = obvHi and not cHi
    obvConf = obvHi and cHi
    rvol = volume / ta.sma(volume, 20)[1]
    vw = math.sum(hlc3 * volume, bd) / math.sum(volume, bd)
    haC = (open + high + low + close) / 4
    var float haO = na
    haO := na(haO[1]) ? (open + close) / 2 : (haO[1] + haC[1]) / 2
    hg = haC > haO
    ret = close / close[bd] - 1
    avgAbs = ta.sma(math.abs(ret), math.min(30 * bd, 4500))
    zs = (close - sma50) / ta.stdev(close, 50)
    s_bb_above = close > bbU and close[1] <= bbU[1]
    s_bb_below = close < bbL and close[1] >= bbL[1]
    s_bb_reentry = close > bbL and close[1] <= bbL[1]
    s_bear_engulfing = bearEng
    s_bear_harami = bearHar
    s_big_bear_bar = isBear and rng >= 2 * A[1] and body >= 0.6 * rng
    s_big_bull_bar = isBull and rng >= 2 * A[1] and body >= 0.6 * rng
    s_bull_belt_hold = f_dn(0) and isBull and open - low <= 0.05 * rng and body >= 0.6 * rng and rng >= A
    s_bull_engulfing = bullEng
    s_bull_harami = bullHar
    s_bull_marubozu = isBull and body >= 0.9 * rng and rng >= A
    s_cci_break = cciV > 100 and cciV[1] <= 100
    s_cci_up = cciV > -100 and cciV[1] <= -100
    s_dark_cloud_cover = f_up(1) and bigGrn1 and isBear and open >= close[1] and close < (open[1] + close[1]) / 2 and close > open[1]
    s_doji_after_drop = f_dn(0) and doji
    s_doji_after_rise = f_up(0) and doji
    s_donchian20 = don20 and not don20[1]
    s_donchian20_down = dd20 and not dd20[1]
    s_donchian55 = don55 and not don55[1]
    s_drop_24h = ret < -2.5 * avgAbs and ret[1] >= -2.5 * avgAbs[1]
    s_ema_9_21_down = e9 < e21 and e9[1] >= e21[1]
    s_ema_9_21_up = e9 > e21 and e9[1] <= e21[1]
    s_evening_star = eStar
    s_five_green = g5 and not g5[1]
    s_five_red = r5 and not r5[1]
    s_ha_green = hg and not hg[1] and not hg[2] and not hg[3]
    s_ha_red = not hg and hg[1] and hg[2] and hg[3]
    s_hammer = f_dn(0) and ham
    s_hanging_man = f_up(0) and ham
    s_holy_grail = adxV > 30 and diP > diM and low <= e20 and close > e20
    s_inside_bar = ins
    s_inside_bar_break_down = ins[1] and close < low[2]
    s_inside_bar_break_up = ins[1] and close > high[2]
    s_inverted_hammer = f_dn(0) and inv
    s_keltner_up = close > kcU and close[1] <= kcU[1]
    s_macd_down = macdL < sigL and macdL[1] >= sigL[1]
    s_macd_hist_turn = hist < 0 and hist > hist[1] and hist[1] <= hist[2]
    s_macd_up = macdUp
    s_macd_up_below0 = macdUp and macdL < 0 and sigL < 0
    s_mfi_ob = mf > 80 and mf[1] <= 80
    s_nr7_break_up = nr7[1] and close > high[1]
    s_obv_confirm = obvConf and not obvConf[1]
    s_obv_lead = obvLead and not obvLead[1]
    s_outside_bar_down = high > high[1] and low < low[1] and close < low[1]
    s_outside_bar_up = high > high[1] and low < low[1] and close > high[1]
    s_rally_24h = ret > 2.5 * avgAbs and ret[1] <= 2.5 * avgAbs[1]
    s_rsi2_connors = rsi2 < 10 and rsi2[1] >= 10 and close > sma200
    s_rsi_dn_70 = rsi14 < 70 and rsi14[1] >= 70
    s_rsi_ob_70 = rsi14 > 70 and rsi14[1] <= 70
    s_spinning_top = body <= 0.3 * rng and body >= 0.1 * rng and upw >= body and loww >= body
    s_stoch_down = stK < stD and stK[1] >= stD[1] and stK[1] > 80
    s_stoch_up = stK > stD and stK[1] <= stD[1] and stK[1] < 20
    s_stochrsi_up = srK > srD and srK[1] <= srD[1] and srK[1] < 0.2
    s_stretch_ema20 = close < e20 - 2.5 * A and close[1] >= e20[1] - 2.5 * A[1]
    s_three_outside_down = bearEng[1] and close < close[1]
    s_three_outside_up = bullEng[1] and close > close[1]
    s_tweezer_bottom = f_dn(1) and isBear[1] and isBull and math.abs(low - low[1]) <= 0.05 * A and rng[1] >= 0.5 * A[1]
    s_tweezer_top = f_up(1) and isBull[1] and isBear and math.abs(high - high[1]) <= 0.05 * A and rng[1] >= 0.5 * A[1]
    s_vol_spike_bull = rvol >= 3 and isBull and body >= 0.5 * rng
    s_vwap_lose = close < vw and close[1] >= vw[1]
    s_vwap_reclaim = close > vw and close[1] <= vw[1]
    s_willr_up = wr > -80 and wr[1] <= -80
    [s_bb_above, s_bb_below, s_bb_reentry, s_bear_engulfing, s_bear_harami, s_big_bear_bar, s_big_bull_bar, s_bull_belt_hold, s_bull_engulfing, s_bull_harami, s_bull_marubozu, s_cci_break, s_cci_up, s_dark_cloud_cover, s_doji_after_drop, s_doji_after_rise, s_donchian20, s_donchian20_down, s_donchian55, s_drop_24h, s_ema_9_21_down, s_ema_9_21_up, s_evening_star, s_five_green, s_five_red, s_ha_green, s_ha_red, s_hammer, s_hanging_man, s_holy_grail, s_inside_bar, s_inside_bar_break_down, s_inside_bar_break_up, s_inverted_hammer, s_keltner_up, s_macd_down, s_macd_hist_turn, s_macd_up, s_macd_up_below0, s_mfi_ob, s_nr7_break_up, s_obv_confirm, s_obv_lead, s_outside_bar_down, s_outside_bar_up, s_rally_24h, s_rsi2_connors, s_rsi_dn_70, s_rsi_ob_70, s_spinning_top, s_stoch_down, s_stoch_up, s_stochrsi_up, s_stretch_ema20, s_three_outside_down, s_three_outside_up, s_tweezer_bottom, s_tweezer_top, s_vol_spike_bull, s_vwap_lose, s_vwap_reclaim, s_willr_up, A]
[c_bb_above, c_bb_below, c_bb_reentry, c_bear_engulfing, c_bear_harami, c_big_bear_bar, c_big_bull_bar, c_bull_belt_hold, c_bull_engulfing, c_bull_harami, c_bull_marubozu, c_cci_break, c_cci_up, c_dark_cloud_cover, c_doji_after_drop, c_doji_after_rise, c_donchian20, c_donchian20_down, c_donchian55, c_drop_24h, c_ema_9_21_down, c_ema_9_21_up, c_evening_star, c_five_green, c_five_red, c_ha_green, c_ha_red, c_hammer, c_hanging_man, c_holy_grail, c_inside_bar, c_inside_bar_break_down, c_inside_bar_break_up, c_inverted_hammer, c_keltner_up, c_macd_down, c_macd_hist_turn, c_macd_up, c_macd_up_below0, c_mfi_ob, c_nr7_break_up, c_obv_confirm, c_obv_lead, c_outside_bar_down, c_outside_bar_up, c_rally_24h, c_rsi2_connors, c_rsi_dn_70, c_rsi_ob_70, c_spinning_top, c_stoch_down, c_stoch_up, c_stochrsi_up, c_stretch_ema20, c_three_outside_down, c_three_outside_up, c_tweezer_bottom, c_tweezer_top, c_vol_spike_bull, c_vwap_lose, c_vwap_reclaim, c_willr_up, atrC] = f_all(bdChart)
[h_bb_above, h_bb_below, h_bb_reentry, h_bear_engulfing, h_bear_harami, h_big_bear_bar, h_big_bull_bar, h_bull_belt_hold, h_bull_engulfing, h_bull_harami, h_bull_marubozu, h_cci_break, h_cci_up, h_dark_cloud_cover, h_doji_after_drop, h_doji_after_rise, h_donchian20, h_donchian20_down, h_donchian55, h_drop_24h, h_ema_9_21_down, h_ema_9_21_up, h_evening_star, h_five_green, h_five_red, h_ha_green, h_ha_red, h_hammer, h_hanging_man, h_holy_grail, h_inside_bar, h_inside_bar_break_down, h_inside_bar_break_up, h_inverted_hammer, h_keltner_up, h_macd_down, h_macd_hist_turn, h_macd_up, h_macd_up_below0, h_mfi_ob, h_nr7_break_up, h_obv_confirm, h_obv_lead, h_outside_bar_down, h_outside_bar_up, h_rally_24h, h_rsi2_connors, h_rsi_dn_70, h_rsi_ob_70, h_spinning_top, h_stoch_down, h_stoch_up, h_stochrsi_up, h_stretch_ema20, h_three_outside_down, h_three_outside_up, h_tweezer_bottom, h_tweezer_top, h_vol_spike_bull, h_vwap_lose, h_vwap_reclaim, h_willr_up, atrH] = request.security(syminfo.tickerid, htfStr, f_all(bdHtf), lookahead=barmerge.lookahead_off)
sigC = array.from(c_bb_above, c_bb_below, c_bb_reentry, c_bear_engulfing, c_bear_harami, c_big_bear_bar, c_big_bull_bar, c_bull_belt_hold, c_bull_engulfing, c_bull_harami, c_bull_marubozu, c_cci_break, c_cci_up, c_dark_cloud_cover, c_doji_after_drop, c_doji_after_rise, c_donchian20, c_donchian20_down, c_donchian55, c_drop_24h, c_ema_9_21_down, c_ema_9_21_up, c_evening_star, c_five_green, c_five_red, c_ha_green, c_ha_red, c_hammer, c_hanging_man, c_holy_grail, c_inside_bar, c_inside_bar_break_down, c_inside_bar_break_up, c_inverted_hammer, c_keltner_up, c_macd_down, c_macd_hist_turn, c_macd_up, c_macd_up_below0, c_mfi_ob, c_nr7_break_up, c_obv_confirm, c_obv_lead, c_outside_bar_down, c_outside_bar_up, c_rally_24h, c_rsi2_connors, c_rsi_dn_70, c_rsi_ob_70, c_spinning_top, c_stoch_down, c_stoch_up, c_stochrsi_up, c_stretch_ema20, c_three_outside_down, c_three_outside_up, c_tweezer_bottom, c_tweezer_top, c_vol_spike_bull, c_vwap_lose, c_vwap_reclaim, c_willr_up)
sigH = array.from(h_bb_above, h_bb_below, h_bb_reentry, h_bear_engulfing, h_bear_harami, h_big_bear_bar, h_big_bull_bar, h_bull_belt_hold, h_bull_engulfing, h_bull_harami, h_bull_marubozu, h_cci_break, h_cci_up, h_dark_cloud_cover, h_doji_after_drop, h_doji_after_rise, h_donchian20, h_donchian20_down, h_donchian55, h_drop_24h, h_ema_9_21_down, h_ema_9_21_up, h_evening_star, h_five_green, h_five_red, h_ha_green, h_ha_red, h_hammer, h_hanging_man, h_holy_grail, h_inside_bar, h_inside_bar_break_down, h_inside_bar_break_up, h_inverted_hammer, h_keltner_up, h_macd_down, h_macd_hist_turn, h_macd_up, h_macd_up_below0, h_mfi_ob, h_nr7_break_up, h_obv_confirm, h_obv_lead, h_outside_bar_down, h_outside_bar_up, h_rally_24h, h_rsi2_connors, h_rsi_dn_70, h_rsi_ob_70, h_spinning_top, h_stoch_down, h_stoch_up, h_stochrsi_up, h_stretch_ema20, h_three_outside_down, h_three_outside_up, h_tweezer_bottom, h_tweezer_top, h_vol_spike_bull, h_vwap_lose, h_vwap_reclaim, h_willr_up)
// the chart bar that closes a higher-timeframe bar: higher-timeframe values are final here
isHtfEnd = time_close == time_close(htfStr)
var int htfCount = 0
if isHtfEnd
    htfCount += 1

// ═════════ trend, Bitcoin regime, weekend
up1 = ta.ema(close, 21) > ta.ema(close, 50) and close > ta.ema(close, 200)
f_uph() => close > ta.ema(close, 50) and ta.ema(close, 21) > ta.ema(close, 50)
upHnow = request.security(syminfo.tickerid, htfStr, f_uph(), lookahead=barmerge.lookahead_off)
var bool upHdone = false
upH = isHtfEnd ? upHnow : upHdone
if isHtfEnd
    upHdone := upHnow
upTrend = up1 and upH
f_btc() =>
    s200 = ta.sma(close, 200)
    r = na(s200) ? na : close > s200 ? 1.0 : 0.0
    r[1]
btcState = request.security("COINBASE:BTCUSD", "D", f_btc(), lookahead=barmerge.lookahead_on)
ownState = request.security(syminfo.tickerid, "D", f_btc(), lookahead=barmerge.lookahead_on)
regState = isMarket ? ownState : btcState
dwMT = dayofweek(time_close, "America/Edmonton")
weekendMT = dwMT == dayofweek.saturday or dwMT == dayofweek.sunday

// ═════════ the volatility gate (this timeframe's trained logistic model)
lg(x) => math.log(math.max(1e-6, x))
lr = nz(math.log(close / close[1]))
rms(k) => math.sqrt(math.sum(lr * lr, k) / k)
bbw = 4 * ta.stdev(close, 20) / ta.sma(close, 20)
r12 = (ta.highest(high, 12) - ta.lowest(low, 12)) / close
r72 = (ta.highest(high, 72) - ta.lowest(low, 72)) / close
hr = hour(time, "UTC")
dw = dayofweek(time, "UTC")
vsd = ta.stdev(volume, 168)
feat = array.from(1.0, lg(atrC / ta.sma(atrC, 168)), lg(bbw / ta.sma(bbw, 168)), lg((math.sum(volume, 6) / 6 + 1e-12) / (ta.sma(volume, 168) + 1e-12)), lg(rms(24) / rms(168)), lg(r12 / ta.sma(r12, 168)), math.min(6.0, math.abs(close - close[12]) / atrC), math.min(6.0, (high - low) / atrC), math.sin(2 * math.pi * hr / 24), math.cos(2 * math.pi * hr / 24), dw == dayofweek.saturday or dw == dayofweek.sunday ? 1.0 : 0.0, lg(rms(6) / rms(168)), lg(r72 / ta.sma(r72, 168)), math.max(-4.0, math.min(4.0, (ta.sma(volume, 24) - ta.sma(volume, 168)) / (vsd > 0 ? vsd : 1e-12))))
zl = 0.0
zq = 0.0
bad = bar_index < 248
gOff = mi * 14
for k = 0 to 13
    x = array.get(feat, k)
    if na(x)
        bad := true
    else
        zz = (x - array.get(G_MU, gOff + k)) / array.get(G_SD, gOff + k)
        zl += zz * array.get(G_WL, gOff + k)
        zq += zz * array.get(G_WQ, gOff + k)
pLoud = 1 / (1 + math.exp(-zl))
pQuiet = 1 / (1 + math.exp(-zq))
gate = bad ? "U" : pLoud >= array.get(G_TL, mi) ? "L" : pQuiet >= array.get(G_TQ, mi) ? "Q" : "N"
gRule = array.get(P_GATE, mi)
gateOk = gate == "U" ? false : iGate == "Off" ? true : iGate == "LOUD only" ? gate == "L" : iGate == "LOUD or NORMAL" ? gate != "Q" : (gRule == 1 ? gate == "L" : gRule == 2 ? gate != "Q" : true)

// ═════════ the council: every enabled agent of this timeframe that fired asks the brain
var int[] lastC = array.new_int(62, -100000)
var int[] lastH = array.new_int(62, -100000)
keepC = array.new_bool(62, false)
keepH = array.new_bool(62, false)
for k = 0 to 61
    if array.get(sigC, k) and bar_index >= 250 and bar_index - array.get(lastC, k) >= 12
        array.set(keepC, k, true)
        array.set(lastC, k, bar_index)
    if isHtfEnd and array.get(sigH, k) and htfCount - array.get(lastH, k) >= 3
        array.set(keepH, k, true)
        array.set(lastH, k, htfCount)
loud = gate == "L"
theta = array.get(P_THETA, mi) + iExtra
zc = array.get(P_Z, mi)
off = array.get(M_OFF, mi)
nA = array.get(M_N, mi)
bestK = -1
bestScore = -1e9
bestM = 0.0
bestStop = 0.0
bestCost = 0.0
firing = 0
entryPx = close * 0.999
for j = 0 to nA - 1
    k = off + j
    s = array.get(A_SIG, k)
    onH = array.get(A_HTF, k)
    fired = onH ? array.get(keepH, s) : array.get(keepC, s)
    v = array.get(A_VAR, k)
    cond = v == 0 or (v == 1 and loud) or (v == 2 and upTrend) or (v == 3 and loud and upTrend)
    if active and bar_index >= 250 and array.get(useOn, s) and (isMarket or array.get(A_MAJ, k) == useMajor) and fired and cond
        firing += 1
        m = na(regState) ? array.get(A_MN, k) : regState == 1.0 ? array.get(A_MB, k) : array.get(A_MF, k)
        se = na(regState) ? array.get(A_SN, k) : regState == 1.0 ? array.get(A_SB, k) : array.get(A_SF, k)
        a = onH ? atrH : atrC
        stopD = iStopMult * (onH ? array.get(P_SH, mi) : array.get(P_SC, mi)) * a
        cost = ((isMarket ? 2 * iMkt : iMaker + iTaker) / 100 + 2 * slip) / (stopD / entryPx)
        score = m - zc * se
        ruleOk = isMarket or (not (array.get(P_WKND, mi) and useMajor and weekendMT) and not (array.get(P_BEARMEME, mi) and not useMajor and btcState == 0.0))
        if gateOk and ruleOk and not na(a) and a > 0 and cost <= iCostMax and score >= theta and score > bestScore
            bestScore := score
            bestK := k
            bestM := m
            bestStop := stopD
            bestCost := cost

// ═════════ one plan per chart: limit entry, stop, target, time limit
var float pEntry = na
var float pStop = na
var float pTarget = na
var float pTp1 = na
var float pBe = na
var bool pMoved = false
var float pQtyFull = 0.0
var int pBar = na
var int pFill = na
var string pAgent = ""
var float pQty = 0.0
buyNow = false
sellMsg = ""
halfNow = false
riskPct = useMajor or isMarket ? iRiskMaj : iRiskMem
busy = not na(pEntry)
holdBars = math.max(1, math.round(iHoldX * array.get(P_HOLD, mi)))
if barstate.isconfirmed and bestK >= 0 and not busy
    buyNow := true
    sz = math.max(0.5, math.min(1.5, 1 + array.get(P_SIZEA, mi) * bestM)) * (bestCost > 0.20 ? 0.5 : 1.0) * (loud ? array.get(P_LOUDM, mi) : 1.0)
    pEntry := entryPx
    pStop := entryPx - bestStop
    pTarget := entryPx + exT * bestStop
    pTp1 := exR > 0 ? entryPx + exR * bestStop : na
    pBe := entryPx * (1 + (isMarket ? 2 * iMkt : iMaker + iTaker) / 100 + slip)
    pMoved := false
    pBar := bar_index
    pFill := na
    pAgent := array.get(A_NAME, bestK)
    pQty := math.min(iAccount * riskPct / 100 * sz / bestStop, iAccount / entryPx)
    if iLines
        line.new(bar_index, pEntry, bar_index + 20, pEntry, color=cBuy, style=line.style_dashed)
        line.new(bar_index, pStop, bar_index + 20, pStop, color=cStop, style=line.style_dashed)
        line.new(bar_index, pTarget, bar_index + 20, pTarget, color=cTarget, style=line.style_dashed)
        if not na(pTp1)
            line.new(bar_index, pTp1, bar_index + 20, pTp1, color=cTarget, style=line.style_dotted)
    if iPast
        label.new(bar_index, low, "BUY\n" + pAgent, style=label.style_label_up, color=cBuy, textcolor=color.white, size=size.small)
else if busy and barstate.isconfirmed and bar_index > pBar
    if na(pFill)
        if low <= pEntry
            pFill := bar_index
        else if bar_index - pBar >= iOrderBars
            sellMsg := "CANCEL"
    if not na(pFill) and sellMsg == ""
        if low <= pStop
            sellMsg := pMoved ? "BREAKEVEN" : "STOP"
        else
            if not pMoved and not na(pTp1) and high >= pTp1
                pMoved := true
                halfNow := true
                pStop := math.max(pStop, pBe)
            if high >= pTarget
                sellMsg := "TARGET"
            else if bar_index - pFill >= holdBars
                sellMsg := "TIME"
    if halfNow and iPast and sellMsg == ""
        label.new(bar_index, high, "SELL HALF\nstop to breakeven", style=label.style_label_down, color=cTarget, textcolor=color.white, size=size.small)
    if sellMsg != ""
        if iPast and sellMsg != "CANCEL"
            label.new(bar_index, high, "SELL\n" + sellMsg, style=label.style_label_down, color=sellMsg == "TARGET" ? cTarget : cStop, textcolor=color.white, size=size.small)
        pEntry := na
        pStop := na
        pTarget := na
        pTp1 := na
        pFill := na
        pMoved := false

// ═════════ alerts: create ONE alert → condition ULTRON → "Any alert() function call"
if buyNow
    msgB = iMsg == "Readable" ? "ULTRON BUY " + syminfo.ticker + " (" + mName + ") · limit " + str.tostring(pEntry, format.mintick) + " · stop " + str.tostring(pStop, format.mintick) + " · sell " + str.tostring(pTarget, format.mintick) + " · size " + str.tostring(pQty, "#.####") + " · agent " + pAgent : '{"ultron":"BUY","symbol":"' + syminfo.ticker + '","tf":"' + mName + '","agent":"' + pAgent + '","entry":' + str.tostring(pEntry, format.mintick) + ',"stop":' + str.tostring(pStop, format.mintick) + ',"target":' + str.tostring(pTarget, format.mintick) + ',"qty":' + str.tostring(pQty, "#.########") + ',"edge_r":' + str.tostring(bestM, "#.###") + '}'
    alert(msgB, alert.freq_once_per_bar_close)
if halfNow and sellMsg == ""
    alert("ULTRON SELL HALF " + syminfo.ticker + " · first target " + str.tostring(pTp1, format.mintick) + " reached · move the stop to breakeven " + str.tostring(pStop, format.mintick) + " · rest sells at " + str.tostring(pTarget, format.mintick), alert.freq_once_per_bar_close)
if sellMsg == "STOP" or sellMsg == "TARGET" or sellMsg == "TIME" or sellMsg == "BREAKEVEN"
    why = sellMsg == "TARGET" ? "target reached" : sellMsg == "STOP" ? "stop-loss hit" : sellMsg == "BREAKEVEN" ? "breakeven stop hit (half was already sold)" : "time limit reached"
    msgS = iMsg == "Readable" ? "ULTRON SELL " + syminfo.ticker + " now · " + why + " · price " + str.tostring(close, format.mintick) : '{"ultron":"SELL","symbol":"' + syminfo.ticker + '","reason":"' + sellMsg + '","price":' + str.tostring(close, format.mintick) + '}'
    alert(msgS, alert.freq_once_per_bar_close)
alertcondition(buyNow, "ULTRON BUY", "ULTRON: BUY {{ticker}} at {{close}} (see chart for entry, stop, target)")
alertcondition(sellMsg == "STOP" or sellMsg == "TARGET" or sellMsg == "TIME" or sellMsg == "BREAKEVEN", "ULTRON SELL", "ULTRON: SELL {{ticker}} at {{close}}")
alertcondition(halfNow, "ULTRON SELL HALF", "ULTRON: SELL HALF {{ticker}} at {{close}}, move the stop to breakeven")

// ═════════ chart
bgcolor(iGateBg and active and gate == "L" ? cLoud : na)
plotshape(buyNow and not iPast, "Council buy", shape.triangleup, location.belowbar, cBuy, size=size.tiny)
posT = iTablePos == "Top right" ? position.top_right : iTablePos == "Top left" ? position.top_left : iTablePos == "Bottom right" ? position.bottom_right : position.bottom_left
tsz = iTableSize == "Tiny" ? size.tiny : iTableSize == "Normal" ? size.normal : size.small
var table T = table.new(posT, 2, 11, bgcolor=color.new(color.white, 0), frame_color=color.new(#D9E0EB, 0), frame_width=1, border_color=color.new(#E9EEF5, 0), border_width=1)
cell(r, a, b, col) =>
    table.cell(T, 0, r, a, text_color=color.new(#56657C, 0), text_size=tsz, text_halign=text.align_left)
    table.cell(T, 1, r, b, text_color=col, text_size=tsz, text_halign=text.align_left)
ink = color.new(#0A1426, 0)
statusTxt = not ((isMarket and hasMkt and (mktKnown or iOther)) or (not isMarket and (isMajor or isMeme or iOther))) ? "Not trained on " + syminfo.ticker : isMarket and not exact ? "Markets: trained on daily (1D) charts only" : not mPassed and iOnlyPassed ? "Flat: this exit style lost money or had too few trades on unseen data here" + (pass2R and exK != 0 ? " · 2R (trained) passed here" : "") : "Untrained timeframe"
unitTxt = isMarket ? "units" : base
gTxt = gate == "L" ? "LOUD (big move likely)" : gate == "Q" ? "QUIET" : gate == "N" ? "NORMAL" : "warming up"
verdict = not active ? statusTxt : not na(pEntry) ? (na(pFill) ? "BUY · limit order waiting" : "IN TRADE") : "WAIT · no setup now"
px(x) => na(x) ? "—" : str.tostring(x, format.mintick)
if barstate.islast and iTable
    table.cell(T, 0, 0, "ULTRON", text_color=color.white, bgcolor=cBuy, text_size=tsz)
    table.cell(T, 1, 0, "AI TRADE COUNCIL", text_color=color.white, bgcolor=cBuy, text_size=tsz)
    cell(1, "Council", mName + (exact ? " (trained)" : " (nearest, untested here)"), ink)
    vcol = not active ? cStop : not na(pEntry) ? cBuy : color.new(#56657C, 0)
    if iSimple
        cell(2, "Now", verdict, vcol)
        cell(3, "Buy at", px(pEntry), cBuy)
        cell(4, "Stop-loss", px(pStop), cStop)
        cell(5, "Sell (target)", na(pTp1) ? px(pTarget) : "half at " + px(pTp1) + ", rest at " + px(pTarget), cTarget)
        cell(6, "Size", na(pEntry) ? "—" : str.tostring(pQty, "#.####") + " " + unitTxt, ink)
        cell(7, "Volatility", active ? gTxt : "—", active and gate == "L" ? cBuy : ink)
        cell(8, "Won in backtest", exName + ": " + wonTxt, ink)
        cell(9, "Not advice", "past results, paper-test first", color.new(#97A3B6, 0))
    else
        cell(2, "Backtest", exName + ": " + wonTxt + (mPassed ? "" : " · caution"), mPassed ? ink : cStop)
        if not active
            cell(3, "Status", statusTxt, cStop)
        else
            cell(3, "Volatility", gTxt + " · LOUD right " + array.get(G_PREC, mi), gate == "L" ? cBuy : ink)
            cell(4, "Trend chart / higher", (up1 ? "up" : "no") + " / " + (upH ? "up" : "no"), ink)
            cell(5, isMarket ? "Regime" : "Bitcoin regime", na(regState) ? "n/a" : regState == 1.0 ? "above 200-day" : "below 200-day", ink)
            cell(6, "Agents firing now", str.tostring(firing) + " of " + str.tostring(nA), ink)
            cell(7, "Decision", verdict, vcol)
            cell(8, "Plan", na(pEntry) ? "—" : "buy " + px(pEntry) + " · stop " + px(pStop) + " · sell " + px(pTarget), ink)
            cell(9, "Agent / size", na(pEntry) ? "—" : pAgent + " · " + str.tostring(pQty, "#.####") + " " + unitTxt, ink)
        cell(10, "Not advice", "paper-test before real money", color.new(#97A3B6, 0))
