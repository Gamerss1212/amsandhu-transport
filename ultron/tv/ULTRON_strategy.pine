var float[] G_SD = array.from(1.0, 0.31845712, 0.59096284, 0.64745282, 0.38362095, 0.50718507, 1.25696881, 0.52659623, 0.70711183, 0.7071017, 0.45165057, 0.55283779, 0.41001939, 0.48672306, 1.0, 0.33240171, 0.5899923, 0.61399984, 0.37710482, 0.50310633, 1.2661615, 0.53960612, 0.70712402, 0.7070895, 0.451468, 0.56602521, 0.41910343, 0.49601691, 1.0, 0.36124685, 0.56740443, 0.58401539, 0.3705157, 0.49027969, 1.25725265, 0.5439368, 0.70712232, 0.70709124, 0.45171522, 0.56793525, 0.42441347, 0.49823322, 1.0, 0.4569736, 0.53938286, 0.52716121, 0.32176929, 0.46090476, 1.28628919, 0.55509171, 1.0, 1.0, 0.45168727, 0.50685547, 0.40465088, 0.53066163)
var float[] G_WL = array.from(-0.79240278, 0.77888342, 0.12517527, 0.00408937, -0.22210503, -0.1910334, 0.08122615, 0.13801996, 0.18562032, -0.2714689, -0.13867655, 0.02503302, 0.05023098, 0.01590603, -0.77671463, 0.57824929, -0.04420623, 0.18138954, -0.21854544, -0.03783305, 0.1268254, 0.12409984, 0.0732359, -0.04486801, -0.06413431, 0.08119431, 0.23461948, -0.01811338, -0.75429505, 0.22893843, -0.06352748, 0.17419493, -0.03410107, 0.10871697, 0.06347504, 0.17251163, 0.0271234, 0.03710084, 0.11944777, 0.0685797, 0.16317775, 0.1148716, -0.78697566, 0.1153833, -0.07784293, 0.54148454, -0.06432937, -0.25962553, 0.17849848, 0.16474785, 0.0, 0.0, 0.03384082, -0.01553786, 0.24444264, 0.00522018)
var float[] G_WQ = array.from(-0.65715546, -0.7879693, -0.15809324, 0.0662735, 0.24754194, 0.18897011, -0.07079198, -0.17524815, -0.17091167, 0.24656256, 0.26754159, -0.0559487, 0.01833281, 0.04452539, -0.63702239, -0.69096014, 0.12029648, -0.05311288, 0.17960987, 0.07753753, -0.16292125, -0.15050618, -0.04361465, 0.02696867, 0.19820507, -0.06672688, -0.20289335, 0.06941506, -0.59740917, -0.4971175, 0.02682835, -0.05674631, 0.0952404, -0.08597192, -0.04081181, -0.17779639, -0.04184137, -0.02561205, -0.04885428, -0.02243451, -0.23074698, -0.02924057, -0.62051931, -0.32920627, 0.02026985, -0.12627576, 0.22307401, 0.32809408, -0.14925422, -0.23847002, 0.0, 0.0, -0.10077898, -0.08359941, -0.50684308, -0.26729686)
var float[] G_TL = array.from(0.621175, 0.645973, 0.628116, 0.562162)
var float[] G_TQ = array.from(0.63675, 0.62689, 0.630119, 0.599922)
var string[] G_PREC = array.from("80%", "83%", "87%", "29%")
useOn = array.from(u_bb_above, u_bb_reentry, u_bear_engulfing, u_big_bull_bar, u_bull_engulfing, u_bull_harami, u_bull_marubozu, u_cci_break, u_doji_after_drop, u_doji_after_rise, u_donchian20, u_donchian55, u_drop_24h, u_ema_9_21_down, u_ema_9_21_up, u_evening_star, u_five_green, u_ha_red, u_hammer, u_inside_bar, u_inside_bar_break_down, u_inverted_hammer, u_keltner_up, u_macd_down, u_macd_hist_turn, u_macd_up, u_macd_up_below0, u_mfi_ob, u_nr7_break_up, u_obv_confirm, u_obv_lead, u_outside_bar_down, u_rally_24h, u_rsi_dn_70, u_rsi_ob_70, u_spinning_top, u_stoch_down, u_stoch_up, u_three_outside_up, u_tweezer_top, u_vol_spike_bull, u_vwap_lose, u_vwap_reclaim)

// ═════════ market
base = syminfo.basecurrency
isMajor = base == "BTC" or base == "ETH" or base == "SOL"
isMeme = base == "DOGE" or base == "SHIB" or base == "PEPE" or base == "BONK" or base == "WIF" or base == "FLOKI"
useMajor = isMajor or (not isMeme and iOther)
active = (isMajor or isMeme or iOther) and (exact or iNearest) and (mPassed or not iOnlyPassed)
slip = useMajor ? 0.0002 : 0.001

// ═════════ the 43 signals the councils use (same formulas on the chart and on the higher timeframe)
f_dn(k) => close[k + 1] < close[k + 6]
f_up(k) => close[k + 1] > close[k + 6]
f_all(bd) =>
    A = ta.atr(14)
    body = math.abs(close - open)
    rng = high - low
    upw = high - math.max(open, close)
    loww = math.min(open, close) - low
    isBull = close > open
    isBear = close < open
    big = rng >= 0.5 * A
    ham = loww >= 2 * body and upw <= 0.1 * rng and body >= 0.05 * rng and big
    inv = upw >= 2 * body and loww <= 0.1 * rng and body >= 0.05 * rng and big
    doji = body <= 0.1 * rng and big
    ins = high < high[1] and low > low[1]
    nr7 = rng <= ta.lowest(rng, 7)
    engUp = isBear[1] and isBull and close >= open[1] and open <= close[1] and body > body[1]
    engDn = isBull[1] and isBear and close <= open[1] and open >= close[1] and body > body[1]
    bullEng = f_dn(1) and engUp
    bearEng = f_up(1) and engDn
    bigRed1 = isBear[1] and body[1] >= 0.6 * rng[1] and body[1] >= 0.75 * A[1]
    bigGrn1 = isBull[1] and body[1] >= 0.6 * rng[1] and body[1] >= 0.75 * A[1]
    harUp = bigRed1 and math.max(open, close) <= open[1] and math.min(open, close) >= close[1] and body <= 0.5 * body[1]
    harDn = bigGrn1 and math.max(open, close) <= close[1] and math.min(open, close) >= open[1] and body <= 0.5 * body[1]
    bullHar = f_dn(1) and harUp and isBull
    bearHar = f_up(1) and harDn and isBear
    bigRed2 = isBear[2] and body[2] >= 0.6 * rng[2] and body[2] >= 0.75 * A[2]
    bigGrn2 = isBull[2] and body[2] >= 0.6 * rng[2] and body[2] >= 0.75 * A[2]
    mStar = f_dn(2) and bigRed2 and body[1] <= 0.3 * body[2] and isBull and close > (open[2] + close[2]) / 2
    eStar = f_up(2) and bigGrn2 and body[1] <= 0.3 * body[2] and isBear and close < (open[2] + close[2]) / 2
    sold = isBull and body >= 0.6 * rng and body >= 0.5 * A and upw <= 0.3 * body
    crow = isBear and body >= 0.6 * rng and body >= 0.5 * A
    tws = sold and sold[1] and sold[2] and close > close[1] and close[1] > close[2] and open >= open[1] and open <= close[1] and open[1] >= open[2] and open[1] <= close[2]
    tbc = crow and crow[1] and crow[2] and close < close[1] and close[1] < close[2] and open <= open[1] and open >= close[1] and open[1] <= open[2] and open[1] >= close[2]
    small3 = body[1] <= 0.5 * body[4] and high[1] <= high[4] and low[1] >= low[4] and body[2] <= 0.5 * body[4] and high[2] <= high[4] and low[2] >= low[4] and body[3] <= 0.5 * body[4] and high[3] <= high[4] and low[3] >= low[4]
    g5 = isBull and isBull[1] and isBull[2] and isBull[3] and isBull[4]
    r5 = isBear and isBear[1] and isBear[2] and isBear[3] and isBear[4]
    rsi14 = ta.rsi(close, 14)
    rsi2 = ta.rsi(close, 2)
    sma50 = ta.sma(close, 50)
    sma200 = ta.sma(close, 200)
    e9 = ta.ema(close, 9)
    e20 = ta.ema(close, 20)
    e21 = ta.ema(close, 21)
    e200 = ta.ema(close, 200)
    macdL = ta.ema(close, 12) - ta.ema(close, 26)
    sigL = ta.ema(macdL, 9)
    hist = macdL - sigL
    macdUp = macdL > sigL and macdL[1] <= sigL[1]
    bbB = ta.sma(close, 20)
    bbD = ta.stdev(close, 20)
    bbU = bbB + 2 * bbD
    bbL = bbB - 2 * bbD
    bw = (bbU - bbL) / bbB
    kcU = e20 + 2 * A
    kcL = e20 - 2 * A
    sq = bbU < kcU and bbL > kcL
    stK = ta.sma(ta.stoch(close, high, low, 14), 3)
    stD = ta.sma(stK, 3)
    srs = (rsi14 - ta.lowest(rsi14, 14)) / (ta.highest(rsi14, 14) - ta.lowest(rsi14, 14))
    srK = ta.sma(srs, 3)
    srD = ta.sma(srK, 3)
    wr = -100 * (ta.highest(high, 14) - close) / (ta.highest(high, 14) - ta.lowest(low, 14))
    cciV = ta.cci(hlc3, 20)
    mf = ta.mfi(hlc3, 14)
    [diP, diM, adxV] = ta.dmi(14, 14)
    don20 = close > ta.highest(high, 20)[1]
    don55 = close > ta.highest(high, 55)[1]
    dd20 = close < ta.lowest(low, 20)[1]
    ob = ta.obv
    obvHi = ob >= ta.highest(ob, 20)[1]
    cHi = close >= ta.highest(close, 20)[1]
    obvLead = obvHi and not cHi
    obvConf = obvHi and cHi
    rvol = volume / ta.sma(volume, 20)[1]
    vw = math.sum(hlc3 * volume, bd) / math.sum(volume, bd)
    haC = (open + high + low + close) / 4
    var float haO = na
    haO := na(haO[1]) ? (open + close) / 2 : (haO[1] + haC[1]) / 2
    hg = haC > haO
    ret = close / close[bd] - 1
    avgAbs = ta.sma(math.abs(ret), math.min(30 * bd, 4500))
    zs = (close - sma50) / ta.stdev(close, 50)
    s_bb_above = close > bbU and close[1] <= bbU[1]
    s_bb_reentry = close > bbL and close[1] <= bbL[1]
    s_bear_engulfing = bearEng
    s_big_bull_bar = isBull and rng >= 2 * A[1] and body >= 0.6 * rng
    s_bull_engulfing = bullEng
    s_bull_harami = bullHar
    s_bull_marubozu = isBull and body >= 0.9 * rng and rng >= A
    s_cci_break = cciV > 100 and cciV[1] <= 100
    s_doji_after_drop = f_dn(0) and doji
    s_doji_after_rise = f_up(0) and doji
    s_donchian20 = don20 and not don20[1]
    s_donchian55 = don55 and not don55[1]
    s_drop_24h = ret < -2.5 * avgAbs and ret[1] >= -2.5 * avgAbs[1]
    s_ema_9_21_down = e9 < e21 and e9[1] >= e21[1]
    s_ema_9_21_up = e9 > e21 and e9[1] <= e21[1]
    s_evening_star = eStar
    s_five_green = g5 and not g5[1]
    s_ha_red = not hg and hg[1] and hg[2] and hg[3]
    s_hammer = f_dn(0) and ham
    s_inside_bar = ins
    s_inside_bar_break_down = ins[1] and close < low[2]
    s_inverted_hammer = f_dn(0) and inv
    s_keltner_up = close > kcU and close[1] <= kcU[1]
    s_macd_down = macdL < sigL and macdL[1] >= sigL[1]
    s_macd_hist_turn = hist < 0 and hist > hist[1] and hist[1] <= hist[2]
    s_macd_up = macdUp
    s_macd_up_below0 = macdUp and macdL < 0 and sigL < 0
    s_mfi_ob = mf > 80 and mf[1] <= 80
    s_nr7_break_up = nr7[1] and close > high[1]
    s_obv_confirm = obvConf and not obvConf[1]
    s_obv_lead = obvLead and not obvLead[1]
    s_outside_bar_down = high > high[1] and low < low[1] and close < low[1]
    s_rally_24h = ret > 2.5 * avgAbs and ret[1] <= 2.5 * avgAbs[1]
    s_rsi_dn_70 = rsi14 < 70 and rsi14[1] >= 70
    s_rsi_ob_70 = rsi14 > 70 and rsi14[1] <= 70
    s_spinning_top = body <= 0.3 * rng and body >= 0.1 * rng and upw >= body and loww >= body
    s_stoch_down = stK < stD and stK[1] >= stD[1] and stK[1] > 80
    s_stoch_up = stK > stD and stK[1] <= stD[1] and stK[1] < 20
    s_three_outside_up = bullEng[1] and close > close[1]
    s_tweezer_top = f_up(1) and isBull[1] and isBear and math.abs(high - high[1]) <= 0.05 * A and rng[1] >= 0.5 * A[1]
    s_vol_spike_bull = rvol >= 3 and isBull and body >= 0.5 * rng
    s_vwap_lose = close < vw and close[1] >= vw[1]
    s_vwap_reclaim = close > vw and close[1] <= vw[1]
    [s_bb_above, s_bb_reentry, s_bear_engulfing, s_big_bull_bar, s_bull_engulfing, s_bull_harami, s_bull_marubozu, s_cci_break, s_doji_after_drop, s_doji_after_rise, s_donchian20, s_donchian55, s_drop_24h, s_ema_9_21_down, s_ema_9_21_up, s_evening_star, s_five_green, s_ha_red, s_hammer, s_inside_bar, s_inside_bar_break_down, s_inverted_hammer, s_keltner_up, s_macd_down, s_macd_hist_turn, s_macd_up, s_macd_up_below0, s_mfi_ob, s_nr7_break_up, s_obv_confirm, s_obv_lead, s_outside_bar_down, s_rally_24h, s_rsi_dn_70, s_rsi_ob_70, s_spinning_top, s_stoch_down, s_stoch_up, s_three_outside_up, s_tweezer_top, s_vol_spike_bull, s_vwap_lose, s_vwap_reclaim, A]
[c_bb_above, c_bb_reentry, c_bear_engulfing, c_big_bull_bar, c_bull_engulfing, c_bull_harami, c_bull_marubozu, c_cci_break, c_doji_after_drop, c_doji_after_rise, c_donchian20, c_donchian55, c_drop_24h, c_ema_9_21_down, c_ema_9_21_up, c_evening_star, c_five_green, c_ha_red, c_hammer, c_inside_bar, c_inside_bar_break_down, c_inverted_hammer, c_keltner_up, c_macd_down, c_macd_hist_turn, c_macd_up, c_macd_up_below0, c_mfi_ob, c_nr7_break_up, c_obv_confirm, c_obv_lead, c_outside_bar_down, c_rally_24h, c_rsi_dn_70, c_rsi_ob_70, c_spinning_top, c_stoch_down, c_stoch_up, c_three_outside_up, c_tweezer_top, c_vol_spike_bull, c_vwap_lose, c_vwap_reclaim, atrC] = f_all(bdChart)
[h_bb_above, h_bb_reentry, h_bear_engulfing, h_big_bull_bar, h_bull_engulfing, h_bull_harami, h_bull_marubozu, h_cci_break, h_doji_after_drop, h_doji_after_rise, h_donchian20, h_donchian55, h_drop_24h, h_ema_9_21_down, h_ema_9_21_up, h_evening_star, h_five_green, h_ha_red, h_hammer, h_inside_bar, h_inside_bar_break_down, h_inverted_hammer, h_keltner_up, h_macd_down, h_macd_hist_turn, h_macd_up, h_macd_up_below0, h_mfi_ob, h_nr7_break_up, h_obv_confirm, h_obv_lead, h_outside_bar_down, h_rally_24h, h_rsi_dn_70, h_rsi_ob_70, h_spinning_top, h_stoch_down, h_stoch_up, h_three_outside_up, h_tweezer_top, h_vol_spike_bull, h_vwap_lose, h_vwap_reclaim, atrH] = request.security(syminfo.tickerid, htfStr, f_all(bdHtf), lookahead=barmerge.lookahead_off)
sigC = array.from(c_bb_above, c_bb_reentry, c_bear_engulfing, c_big_bull_bar, c_bull_engulfing, c_bull_harami, c_bull_marubozu, c_cci_break, c_doji_after_drop, c_doji_after_rise, c_donchian20, c_donchian55, c_drop_24h, c_ema_9_21_down, c_ema_9_21_up, c_evening_star, c_five_green, c_ha_red, c_hammer, c_inside_bar, c_inside_bar_break_down, c_inverted_hammer, c_keltner_up, c_macd_down, c_macd_hist_turn, c_macd_up, c_macd_up_below0, c_mfi_ob, c_nr7_break_up, c_obv_confirm, c_obv_lead, c_outside_bar_down, c_rally_24h, c_rsi_dn_70, c_rsi_ob_70, c_spinning_top, c_stoch_down, c_stoch_up, c_three_outside_up, c_tweezer_top, c_vol_spike_bull, c_vwap_lose, c_vwap_reclaim)
sigH = array.from(h_bb_above, h_bb_reentry, h_bear_engulfing, h_big_bull_bar, h_bull_engulfing, h_bull_harami, h_bull_marubozu, h_cci_break, h_doji_after_drop, h_doji_after_rise, h_donchian20, h_donchian55, h_drop_24h, h_ema_9_21_down, h_ema_9_21_up, h_evening_star, h_five_green, h_ha_red, h_hammer, h_inside_bar, h_inside_bar_break_down, h_inverted_hammer, h_keltner_up, h_macd_down, h_macd_hist_turn, h_macd_up, h_macd_up_below0, h_mfi_ob, h_nr7_break_up, h_obv_confirm, h_obv_lead, h_outside_bar_down, h_rally_24h, h_rsi_dn_70, h_rsi_ob_70, h_spinning_top, h_stoch_down, h_stoch_up, h_three_outside_up, h_tweezer_top, h_vol_spike_bull, h_vwap_lose, h_vwap_reclaim)
// the chart bar that closes a higher-timeframe bar: higher-timeframe values are final here
isHtfEnd = time_close == time_close(htfStr)
var int htfCount = 0
if isHtfEnd
    htfCount += 1

// ═════════ trend, Bitcoin regime, weekend
up1 = ta.ema(close, 21) > ta.ema(close, 50) and close > ta.ema(close, 200)
f_uph() => close > ta.ema(close, 50) and ta.ema(close, 21) > ta.ema(close, 50)
upHnow = request.security(syminfo.tickerid, htfStr, f_uph(), lookahead=barmerge.lookahead_off)
var bool upHdone = false
upH = isHtfEnd ? upHnow : upHdone
if isHtfEnd
    upHdone := upHnow
upTrend = up1 and upH
f_btc() =>
    s200 = ta.sma(close, 200)
    r = na(s200) ? na : close > s200 ? 1.0 : 0.0
    r[1]
btcState = request.security("COINBASE:BTCUSD", "D", f_btc(), lookahead=barmerge.lookahead_on)
dwMT = dayofweek(time_close, "America/Edmonton")
weekendMT = dwMT == dayofweek.saturday or dwMT == dayofweek.sunday

// ═════════ the volatility gate (this timeframe's trained logistic model)
lg(x) => math.log(math.max(1e-6, x))
lr = nz(math.log(close / close[1]))
rms(k) => math.sqrt(math.sum(lr * lr, k) / k)
bbw = 4 * ta.stdev(close, 20) / ta.sma(close, 20)
r12 = (ta.highest(high, 12) - ta.lowest(low, 12)) / close
r72 = (ta.highest(high, 72) - ta.lowest(low, 72)) / close
hr = hour(time, "UTC")
dw = dayofweek(time, "UTC")
vsd = ta.stdev(volume, 168)
feat = array.from(1.0, lg(atrC / ta.sma(atrC, 168)), lg(bbw / ta.sma(bbw, 168)), lg((math.sum(volume, 6) / 6 + 1e-12) / (ta.sma(volume, 168) + 1e-12)), lg(rms(24) / rms(168)), lg(r12 / ta.sma(r12, 168)), math.min(6.0, math.abs(close - close[12]) / atrC), math.min(6.0, (high - low) / atrC), math.sin(2 * math.pi * hr / 24), math.cos(2 * math.pi * hr / 24), dw == dayofweek.saturday or dw == dayofweek.sunday ? 1.0 : 0.0, lg(rms(6) / rms(168)), lg(r72 / ta.sma(r72, 168)), math.max(-4.0, math.min(4.0, (ta.sma(volume, 24) - ta.sma(volume, 168)) / (vsd > 0 ? vsd : 1e-12))))
zl = 0.0
zq = 0.0
bad = bar_index < 248
gOff = mi * 14
for k = 0 to 13
    x = array.get(feat, k)
    if na(x)
        bad := true
    else
        zz = (x - array.get(G_MU, gOff + k)) / array.get(G_SD, gOff + k)
        zl += zz * array.get(G_WL, gOff + k)
        zq += zz * array.get(G_WQ, gOff + k)
pLoud = 1 / (1 + math.exp(-zl))
pQuiet = 1 / (1 + math.exp(-zq))
gate = bad ? "U" : pLoud >= array.get(G_TL, mi) ? "L" : pQuiet >= array.get(G_TQ, mi) ? "Q" : "N"
gRule = array.get(P_GATE, mi)
gateOk = gate == "U" ? false : iGate == "Off" ? true : iGate == "LOUD only" ? gate == "L" : iGate == "LOUD or NORMAL" ? gate != "Q" : (gRule == 1 ? gate == "L" : gRule == 2 ? gate != "Q" : true)

// ═════════ the council: every enabled agent of this timeframe that fired asks the brain
var int[] lastC = array.new_int(43, -100000)
var int[] lastH = array.new_int(43, -100000)
keepC = array.new_bool(43, false)
keepH = array.new_bool(43, false)
for k = 0 to 42
    if array.get(sigC, k) and bar_index >= 250 and bar_index - array.get(lastC, k) >= 12
        array.set(keepC, k, true)
        array.set(lastC, k, bar_index)
    if isHtfEnd and array.get(sigH, k) and htfCount - array.get(lastH, k) >= 3
        array.set(keepH, k, true)
        array.set(lastH, k, htfCount)
loud = gate == "L"
theta = array.get(P_THETA, mi) + iExtra
zc = array.get(P_Z, mi)
off = array.get(M_OFF, mi)
nA = array.get(M_N, mi)
bestK = -1
bestScore = -1e9
bestM = 0.0
bestStop = 0.0
bestCost = 0.0
firing = 0
entryPx = close * 0.999
for j = 0 to nA - 1
    k = off + j
    s = array.get(A_SIG, k)
    onH = array.get(A_HTF, k)
    fired = onH ? array.get(keepH, s) : array.get(keepC, s)
    v = array.get(A_VAR, k)
    cond = v == 0 or (v == 1 and loud) or (v == 2 and upTrend) or (v == 3 and loud and upTrend)
    if active and bar_index >= 250 and array.get(useOn, s) and array.get(A_MAJ, k) == useMajor and fired and cond
        firing += 1
        m = na(btcState) ? array.get(A_MN, k) : btcState == 1.0 ? array.get(A_MB, k) : array.get(A_MF, k)
        se = na(btcState) ? array.get(A_SN, k) : btcState == 1.0 ? array.get(A_SB, k) : array.get(A_SF, k)
        a = onH ? atrH : atrC
        stopD = iStopMult * a
        cost = ((iMaker + iTaker) / 100 + 2 * slip) / (stopD / entryPx)
        score = m - zc * se
        ruleOk = not (array.get(P_WKND, mi) and useMajor and weekendMT) and not (array.get(P_BEARMEME, mi) and not useMajor and btcState == 0.0)
        if gateOk and ruleOk and not na(a) and a > 0 and cost <= iCostMax and score >= theta and score > bestScore
            bestScore := score
            bestK := k
            bestM := m
            bestStop := stopD
            bestCost := cost

// ═════════ one plan per chart: limit entry, stop, target, time limit
var float pEntry = na
var float pStop = na
var float pTarget = na
var int pBar = na
var int pFill = na
var string pAgent = ""
var float pQty = 0.0
buyNow = false
sellMsg = ""
riskPct = useMajor ? iRiskMaj : iRiskMem
busy = not na(pEntry)
if barstate.isconfirmed and bestK >= 0 and not busy
    buyNow := true
    sz = math.max(0.5, math.min(1.5, 1 + array.get(P_SIZEA, mi) * bestM)) * (bestCost > 0.20 ? 0.5 : 1.0) * (loud ? array.get(P_LOUDM, mi) : 1.0)
    pEntry := entryPx
    pStop := entryPx - bestStop
    pTarget := entryPx + iTargetR * bestStop
    pBar := bar_index
    pFill := na
    pAgent := array.get(A_NAME, bestK)
    pQty := math.min(iAccount * riskPct / 100 * sz / bestStop, iAccount / entryPx)
    strategy.entry("ULTRON", strategy.long, qty=pQty, limit=pEntry, comment=pAgent)
    strategy.exit("EXIT", "ULTRON", stop=pStop, limit=pTarget)
    if iLines
        line.new(bar_index, pEntry, bar_index + 20, pEntry, color=cBuy, style=line.style_dashed)
        line.new(bar_index, pStop, bar_index + 20, pStop, color=cStop, style=line.style_dashed)
        line.new(bar_index, pTarget, bar_index + 20, pTarget, color=cTarget, style=line.style_dashed)
    if iPast
        label.new(bar_index, low, "BUY\n" + pAgent, style=label.style_label_up, color=cBuy, textcolor=color.white, size=size.small)
else if busy and barstate.isconfirmed and bar_index > pBar
    if na(pFill) and strategy.position_size > 0
        pFill := bar_index
    if na(pFill) and bar_index - pBar >= iOrderBars
        strategy.cancel("ULTRON")
        sellMsg := "CANCEL"
    else if not na(pFill)
        if bar_index - pFill >= iHold
            strategy.close("ULTRON", comment="time")
            sellMsg := "TIME"
        else if strategy.position_size == 0
            sellMsg := high >= pTarget ? "TARGET" : "STOP"
    if sellMsg != ""
        if iPast and sellMsg != "CANCEL"
            label.new(bar_index, high, "SELL\n" + sellMsg, style=label.style_label_down, color=sellMsg == "TARGET" ? cTarget : cStop, textcolor=color.white, size=size.small)
        pEntry := na
        pStop := na
        pTarget := na
        pFill := na

// ═════════ alerts: create ONE alert → condition ULTRON → "Any alert() function call"
if buyNow
    msgB = iMsg == "Readable" ? "ULTRON BUY " + syminfo.ticker + " (" + mName + ") · limit " + str.tostring(pEntry, format.mintick) + " · stop " + str.tostring(pStop, format.mintick) + " · sell " + str.tostring(pTarget, format.mintick) + " · size " + str.tostring(pQty, "#.####") + " · agent " + pAgent : '{"ultron":"BUY","symbol":"' + syminfo.ticker + '","tf":"' + mName + '","agent":"' + pAgent + '","entry":' + str.tostring(pEntry, format.mintick) + ',"stop":' + str.tostring(pStop, format.mintick) + ',"target":' + str.tostring(pTarget, format.mintick) + ',"qty":' + str.tostring(pQty, "#.########") + ',"edge_r":' + str.tostring(bestM, "#.###") + '}'
    alert(msgB, alert.freq_once_per_bar_close)
if sellMsg == "STOP" or sellMsg == "TARGET" or sellMsg == "TIME"
    why = sellMsg == "TARGET" ? "target reached" : sellMsg == "STOP" ? "stop-loss hit" : "time limit reached"
    msgS = iMsg == "Readable" ? "ULTRON SELL " + syminfo.ticker + " now · " + why + " · price " + str.tostring(close, format.mintick) : '{"ultron":"SELL","symbol":"' + syminfo.ticker + '","reason":"' + sellMsg + '","price":' + str.tostring(close, format.mintick) + '}'
    alert(msgS, alert.freq_once_per_bar_close)

// ═════════ chart
bgcolor(iGateBg and active and gate == "L" ? cLoud : na)
plotshape(buyNow and not iPast, "Council buy", shape.triangleup, location.belowbar, cBuy, size=size.tiny)
posT = iTablePos == "Top right" ? position.top_right : iTablePos == "Top left" ? position.top_left : iTablePos == "Bottom right" ? position.bottom_right : position.bottom_left
tsz = iTableSize == "Tiny" ? size.tiny : iTableSize == "Normal" ? size.normal : size.small
var table T = table.new(posT, 2, 11, bgcolor=color.new(color.white, 0), frame_color=color.new(#D9E0EB, 0), frame_width=1, border_color=color.new(#E9EEF5, 0), border_width=1)
cell(r, a, b, col) =>
    table.cell(T, 0, r, a, text_color=color.new(#56657C, 0), text_size=tsz, text_halign=text.align_left)
    table.cell(T, 1, r, b, text_color=col, text_size=tsz, text_halign=text.align_left)
ink = color.new(#0A1426, 0)
if barstate.islast and iTable
    table.cell(T, 0, 0, "ULTRON", text_color=color.white, bgcolor=cBuy, text_size=tsz)
    table.cell(T, 1, 0, "AI TRADE COUNCIL", text_color=color.white, bgcolor=cBuy, text_size=tsz)
    cell(1, "Council", mName + (exact ? " (trained)" : " (nearest, untested here)"), ink)
    cell(2, "Backtest", mTest + (mPassed ? "" : " · caution"), mPassed ? ink : cStop)
    if not active
        cell(3, "Status", not (isMajor or isMeme or iOther) ? "Not trained on " + base : not mPassed and iOnlyPassed ? "Off: this timeframe failed the test" : "Untrained timeframe", cStop)
    else
        gTxt = gate == "L" ? "LOUD (big move likely)" : gate == "Q" ? "QUIET" : gate == "N" ? "NORMAL" : "warming up"
        cell(3, "Volatility", gTxt + " · LOUD right " + array.get(G_PREC, mi), gate == "L" ? cBuy : ink)
        cell(4, "Trend chart / higher", (up1 ? "up" : "no") + " / " + (upH ? "up" : "no"), ink)
        cell(5, "Bitcoin regime", na(btcState) ? "n/a" : btcState == 1.0 ? "above 200-day" : "below 200-day", ink)
        cell(6, "Agents firing now", str.tostring(firing) + " of " + str.tostring(nA), ink)
        verdict = not na(pEntry) ? (na(pFill) ? "BUY ORDER WAITING" : "IN TRADE") : "WAIT"
        cell(7, "Decision", verdict, not na(pEntry) ? cBuy : color.new(#56657C, 0))
        cell(8, "Plan", na(pEntry) ? "—" : "buy " + str.tostring(pEntry, format.mintick) + " · stop " + str.tostring(pStop, format.mintick) + " · sell " + str.tostring(pTarget, format.mintick), ink)
        cell(9, "Agent / size", na(pEntry) ? "—" : pAgent + " · " + str.tostring(pQty, "#.####") + " " + base, ink)
    cell(10, "Not advice", "paper-test before real money", color.new(#97A3B6, 0))
