//@version=5
strategy("ULTRON · AI trade council · all timeframes (strategy)", shorttitle="ULTRON", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000, pyramiding=0, initial_capital=1000, default_qty_type=strategy.fixed, commission_type=strategy.commission.percent, commission_value=0.2, slippage=2)

