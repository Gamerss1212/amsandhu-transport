// ULTRON Radar · generated by ultron/tv/build_radar.py from the trained models. Educational, not advice.
//@version=5
indicator("ULTRON Radar · volatility forecast, trend, stop and size", shorttitle="ULTRON Radar", overlay=true, max_bars_back=5000)

gA = "Your account"
iAccount = input.float(1000, "Account size ($)", minval=10, group=gA)
iRisk = input.float(0.5, "Risk per trade (%)", minval=0.05, maxval=5, step=0.05, group=gA)
iFeeC = input.float(0.20, "Crypto: fee per side (%)", minval=0, step=0.01, group=gA, tooltip="NDAX 0.20 · Kraken Pro 0.25-0.40 · Coinbase 0.40-0.60")
iFeeM = input.float(0.05, "Stocks, ETFs, forex: cost per side (%)", minval=0, step=0.01, group=gA)
gS = "Stop and target"
iStopX = input.float(1.0, "Stop distance (x the trained stop)", minval=0.25, step=0.05, group=gS, tooltip="Trained stop: 4x ATR on 1h and slower, wider on 5m-30m.")
iTargetR = input.float(2.0, "Target (R)", minval=0.5, step=0.25, group=gS)
iLines = input.bool(true, "Draw the stop and target for a long entered now", group=gS)
gD = "Display"
iTable = input.bool(true, "Show the table", group=gD)
iPos = input.string("Top right", "Table position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=gD)
iText = input.string("Small", "Table text", options=["Tiny", "Small", "Normal"], group=gD)
iTintL = input.bool(true, "Tint LOUD periods", group=gD)
iTintQ = input.bool(true, "Tint QUIET periods", group=gD)
cLoud = input.color(color.new(#1F5BFF, 90), "LOUD", group=gD, inline="c")
cQuiet = input.color(color.new(#8A94A6, 92), "QUIET", group=gD, inline="c")
cStop = input.color(color.new(#E2474D, 0), "Stop", group=gD, inline="c")
cTarget = input.color(color.new(#0E9F63, 0), "Target", group=gD, inline="c")

// ═════════ which model: this chart's timeframe, or the nearest trained one
isMarket = syminfo.type != "crypto"
tfSec = timeframe.in_seconds()
exactC = tfSec == 300 or tfSec == 900 or tfSec == 1800 or tfSec == 3600 or tfSec == 7200 or tfSec == 14400 or tfSec == 86400
miC = tfSec < 519 ? 0 : tfSec < 1272 ? 1 : tfSec < 2545 ? 2 : tfSec < 5091 ? 3 : tfSec < 10182 ? 4 : tfSec < 35272 ? 5 : 6
useMkt = isMarket and tfSec == 86400
mi = useMkt ? 7 : miC
exact = useMkt or (not isMarket and exactC)
mName = mi == 0 ? "5m crypto" : mi == 1 ? "15m crypto" : mi == 2 ? "30m crypto" : mi == 3 ? "1h crypto" : mi == 4 ? "2h crypto" : mi == 5 ? "4h crypto" : mi == 6 ? "1D crypto" : "1D markets"
htfStr = mi == 0 ? "15" : mi == 1 ? "60" : mi == 2 ? "120" : mi == 3 ? "240" : mi == 4 ? "480" : mi == 5 ? "D" : mi == 6 ? "W" : "W"
var float[] G_MU = array.from(0.0, -0.03253478, -0.12019929, -0.23535148, -0.10365608, -0.09621157, 1.66992847, 0.98091868, -0.00085268, -0.00016234, 0.28493734, -0.20757182, -0.05559745, 0.00454604, 0.0, -0.03152474, -0.13221891, -0.22403369, -0.11333983, -0.10585087, 1.59433532, 0.98733103, -0.00061004, -0.00008791, 0.28511088, -0.23248327, -0.05388081, 0.00629933, 0.0, -0.03254975, -0.13824407, -0.21891957, -0.11637698, -0.10781968, 1.59935248, 0.98856975, -0.00017196, -0.00026739, 0.28503871, -0.25141117, -0.05492255, 0.00023166, 0.0, -0.04035717, -0.15548584, -0.19200834, -0.12993081, -0.11763269, 1.58404434, 0.98695239, 0.00001015, -0.00020117, 0.28549648, -0.28392976, -0.05989721, -0.00949292, 0.0, -0.04543881, -0.15605803, -0.17119972, -0.13011054, -0.11531542, 1.62310938, 0.98633634, -0.00022392, 0.00005496, 0.28511248, -0.2901118, -0.06104676, -0.01054739, 0.0, -0.05220553, -0.14800495, -0.15333357, -0.12981066, -0.11133826, 1.59105047, 0.98581661, -0.00003807, 0.0, 0.28563265, -0.29061335, -0.06403202, -0.00863792, 0.0, -0.06233764, -0.15130464, -0.15154518, -0.10834668, -0.11129194, 1.62585013, 0.98623463, 0.0, 1.0, 0.28557377, -0.25102215, -0.07197294, -0.03449098, 0.0, 0.01215155, -0.09425696, -0.04547471, -0.08732071, -0.07631407, 1.90403332, 0.88677536, 0.0, 1.0, 0.0, -0.19495637, -0.04308911, -0.01472761)
var float[] G_SD = array.from(1.0, 0.31138202, 0.52998899, 0.75125906, 0.34717949, 0.47397457, 1.26545058, 0.44552992, 0.70711532, 0.70709771, 0.4513846, 0.49381038, 0.41994566, 0.5211184, 1.0, 0.30931426, 0.56026971, 0.72489102, 0.36517762, 0.49801547, 1.22470377, 0.46435197, 0.70713989, 0.7070734, 0.45146724, 0.50761539, 0.41820323, 0.52925031, 1.0, 0.3194299, 0.57373156, 0.70880439, 0.36898876, 0.50462339, 1.23357556, 0.48576021, 0.70712539, 0.7070881, 0.45143288, 0.52692446, 0.42061639, 0.50815569, 1.0, 0.31845712, 0.59096284, 0.64745282, 0.38362095, 0.50718507, 1.25696881, 0.52659623, 0.70711183, 0.7071017, 0.45165057, 0.55283779, 0.41001939, 0.48672306, 1.0, 0.33240171, 0.5899923, 0.61399984, 0.37710482, 0.50310633, 1.2661615, 0.53960612, 0.70712402, 0.7070895, 0.451468, 0.56602521, 0.41910343, 0.49601691, 1.0, 0.36124685, 0.56740443, 0.58401539, 0.3705157, 0.49027969, 1.25725265, 0.5439368, 0.70712232, 0.70709124, 0.45171522, 0.56793525, 0.42441347, 0.49823322, 1.0, 0.4569736, 0.53938286, 0.52716121, 0.32176929, 0.46090476, 1.28628919, 0.55509171, 1.0, 1.0, 0.45168727, 0.50685547, 0.40465088, 0.53066163, 1.0, 0.27103726, 0.47014951, 0.32042403, 0.31255303, 0.42249691, 1.39576977, 0.37278025, 1.0, 1.0, 1.0, 0.46835986, 0.36318599, 0.46054784)
var float[] G_WL = array.from(-0.76805543, 1.22830657, -0.09026469, 0.12141701, -0.3229729, -0.11812078, 0.19087171, 0.13603591, -0.00280161, -0.07109297, -0.30287778, 0.01797622, -0.09976767, 0.006474, -0.78724368, 1.12366806, -0.071031, 0.09827952, -0.22085651, -0.26267916, 0.1419906, 0.18224822, -0.09134463, -0.32212298, -0.26070149, -0.00260214, -0.03136917, -0.11925582, -0.78299175, 1.12942646, -0.09723755, -0.030815, -0.09157116, -0.16183172, 0.13901142, 0.15107847, 0.02115396, -0.38376512, -0.14324308, -0.02242596, 0.01222647, -0.13319112, -0.79240278, 0.77888342, 0.12517527, 0.00408937, -0.22210503, -0.1910334, 0.08122615, 0.13801996, 0.18562032, -0.2714689, -0.13867655, 0.02503302, 0.05023098, 0.01590603, -0.77671463, 0.57824929, -0.04420623, 0.18138954, -0.21854544, -0.03783305, 0.1268254, 0.12409984, 0.0732359, -0.04486801, -0.06413431, 0.08119431, 0.23461948, -0.01811338, -0.75429505, 0.22893843, -0.06352748, 0.17419493, -0.03410107, 0.10871697, 0.06347504, 0.17251163, 0.0271234, 0.03710084, 0.11944777, 0.0685797, 0.16317775, 0.1148716, -0.78697566, 0.1153833, -0.07784293, 0.54148454, -0.06432937, -0.25962553, 0.17849848, 0.16474785, 0.0, 0.0, 0.03384082, -0.01553786, 0.24444264, 0.00522018, -0.71618855, 0.19434841, 0.02872225, -0.04357272, 0.20274471, 0.30007382, -0.16454893, 0.15041454, 0.0, 0.0, 0.0, 0.11294237, 0.12683231, 0.05880107)
var float[] G_WQ = array.from(-0.71350186, -1.18399871, 0.06952846, -0.06186877, 0.33857105, 0.12451232, -0.20305884, -0.12265613, 0.03006537, 0.06499053, 0.32131755, -0.02217419, 0.0946048, -0.08536985, -0.74079568, -1.15899659, 0.07755161, -0.06323477, 0.27502988, 0.23637411, -0.18305491, -0.18582265, 0.0962674, 0.28736447, 0.32157357, -0.00617539, 0.05986263, 0.09381984, -0.75271244, -1.11704907, 0.05815662, 0.00955993, 0.11722379, 0.19760617, -0.14774734, -0.17582204, 0.00583139, 0.33470721, 0.23871965, 0.02014563, 0.07704687, 0.14758509, -0.65715546, -0.7879693, -0.15809324, 0.0662735, 0.24754194, 0.18897011, -0.07079198, -0.17524815, -0.17091167, 0.24656256, 0.26754159, -0.0559487, 0.01833281, 0.04452539, -0.63702239, -0.69096014, 0.12029648, -0.05311288, 0.17960987, 0.07753753, -0.16292125, -0.15050618, -0.04361465, 0.02696867, 0.19820507, -0.06672688, -0.20289335, 0.06941506, -0.59740917, -0.4971175, 0.02682835, -0.05674631, 0.0952404, -0.08597192, -0.04081181, -0.17779639, -0.04184137, -0.02561205, -0.04885428, -0.02243451, -0.23074698, -0.02924057, -0.62051931, -0.32920627, 0.02026985, -0.12627576, 0.22307401, 0.32809408, -0.14925422, -0.23847002, 0.0, 0.0, -0.10077898, -0.08359941, -0.50684308, -0.26729686, -0.5955303, -0.2898272, -0.03770005, 0.06072607, -0.12548925, -0.26400929, 0.18613742, -0.13445751, 0.0, 0.0, 0.0, -0.09192632, -0.15568659, -0.08450543)
var float[] G_TL = array.from(0.730561, 0.685067, 0.686702, 0.621175, 0.645973, 0.628116, 0.562162, 0.668685)
var float[] G_TQ = array.from(0.68239, 0.687253, 0.676569, 0.63675, 0.62689, 0.630119, 0.599922, 0.648265)
var string[] G_PL = array.from("81%", "72%", "74%", "80%", "83%", "87%", "29%", "80%")
var string[] G_PQ = array.from("66%", "69%", "71%", "56%", "44%", "41%", "37%", "77%")
var string[] G_BASE = array.from("35%", "33%", "33%", "32%", "32%", "33%", "30%", "40%")
var float[] P_SC = array.from(4.0, 8.0, 5.657, 4.0, 4.0, 4.0, 4.0, 4.0)
var int[] G_WIN = array.from(720, 720, 720, 720, 360, 180, 120, 120)

// ═════════ the volatility forecast (14 features, logistic model trained on this timeframe)
atrC = ta.atr(14)
lg(x) => math.log(math.max(1e-6, x))
lr = nz(math.log(close / close[1]))
rms(k) => math.sqrt(math.sum(lr * lr, k) / k)
bbw = 4 * ta.stdev(close, 20) / ta.sma(close, 20)
r12 = (ta.highest(high, 12) - ta.lowest(low, 12)) / close
r72 = (ta.highest(high, 72) - ta.lowest(low, 72)) / close
hr = hour(time, "UTC")
dw = dayofweek(time, "UTC")
vsd = ta.stdev(volume, 168)
feat = array.from(1.0, lg(atrC / ta.sma(atrC, 168)), lg(bbw / ta.sma(bbw, 168)), lg((math.sum(volume, 6) / 6 + 1e-12) / (ta.sma(volume, 168) + 1e-12)), lg(rms(24) / rms(168)), lg(r12 / ta.sma(r12, 168)), math.min(6.0, math.abs(close - close[12]) / atrC), math.min(6.0, (high - low) / atrC), math.sin(2 * math.pi * hr / 24), math.cos(2 * math.pi * hr / 24), dw == dayofweek.saturday or dw == dayofweek.sunday ? 1.0 : 0.0, lg(rms(6) / rms(168)), lg(r72 / ta.sma(r72, 168)), math.max(-4.0, math.min(4.0, (ta.sma(volume, 24) - ta.sma(volume, 168)) / (vsd > 0 ? vsd : 1e-12))))
zl = 0.0
zq = 0.0
bad = bar_index < 248
gOff = mi * 14
for k = 0 to 13
    x = array.get(feat, k)
    if na(x)
        bad := true
    else
        zz = (x - array.get(G_MU, gOff + k)) / array.get(G_SD, gOff + k)
        zl += zz * array.get(G_WL, gOff + k)
        zq += zz * array.get(G_WQ, gOff + k)
gate = bad ? "U" : 1 / (1 + math.exp(-zl)) >= array.get(G_TL, mi) ? "L" : 1 / (1 + math.exp(-zq)) >= array.get(G_TQ, mi) ? "Q" : "N"
// what LOUD and QUIET mean here: the next 12 bars' high-low range vs the last month of finished 12-bar ranges
rngDone = (ta.highest(high, 12) - ta.lowest(low, 12)) / close[12]
winN = array.get(G_WIN, mi)
big720 = ta.percentile_nearest_rank(rngDone, 720, 66.67)
small720 = ta.percentile_nearest_rank(rngDone, 720, 33.33)
big360 = ta.percentile_nearest_rank(rngDone, 360, 66.67)
small360 = ta.percentile_nearest_rank(rngDone, 360, 33.33)
big180 = ta.percentile_nearest_rank(rngDone, 180, 66.67)
small180 = ta.percentile_nearest_rank(rngDone, 180, 33.33)
big120 = ta.percentile_nearest_rank(rngDone, 120, 66.67)
small120 = ta.percentile_nearest_rank(rngDone, 120, 33.33)
bigCutW = winN >= 720 ? big720 : winN >= 360 ? big360 : winN >= 180 ? big180 : big120
smallCutW = winN >= 720 ? small720 : winN >= 360 ? small360 : winN >= 180 ? small180 : small120

// ═════════ trend, stop, fee cost, size
up1 = ta.ema(close, 21) > ta.ema(close, 50) and close > ta.ema(close, 200)
dn1 = ta.ema(close, 21) < ta.ema(close, 50) and close < ta.ema(close, 200)
f_uph() => close > ta.ema(close, 50) and ta.ema(close, 21) > ta.ema(close, 50)
upH = request.security(syminfo.tickerid, htfStr, f_uph()[1], lookahead=barmerge.lookahead_on)
stopD = iStopX * array.get(P_SC, mi) * atrC
stopPct = stopD / close * 100
fee = isMarket ? iFeeM : iFeeC
slip = isMarket ? 0.02 : (syminfo.basecurrency == "BTC" or syminfo.basecurrency == "ETH" or syminfo.basecurrency == "SOL" ? 0.02 : 0.10)
costR = (2 * fee + 2 * slip) / stopPct
qty = math.min(iAccount * iRisk / 100 / stopD, iAccount / close)

// ═════════ chart
bgcolor(iTintL and gate == "L" ? cLoud : iTintQ and gate == "Q" ? cQuiet : na, title="Volatility forecast")
var line lS = na
var line lT = na
if barstate.islast and iLines and not na(stopD)
    line.delete(lS)
    line.delete(lT)
    lS := line.new(bar_index - 5, close - stopD, bar_index + 15, close - stopD, color=cStop, style=line.style_dashed)
    lT := line.new(bar_index - 5, close + iTargetR * stopD, bar_index + 15, close + iTargetR * stopD, color=cTarget, style=line.style_dashed)
loudStart = gate == "L" and gate[1] != "L"
quietStart = gate == "Q" and gate[1] != "Q"
plotshape(loudStart, "LOUD starts", shape.diamond, location.top, color.new(#1F5BFF, 0), size=size.tiny)
alertcondition(loudStart, "ULTRON Radar: LOUD", "ULTRON Radar: {{ticker}} LOUD, a big move is likely in the next 12 bars (direction unknown)")
alertcondition(quietStart, "ULTRON Radar: QUIET", "ULTRON Radar: {{ticker}} QUIET, a small move is likely: fees eat small moves")
if barstate.isconfirmed and loudStart
    alert("ULTRON Radar: " + syminfo.ticker + " LOUD · a big move is likely in the next 12 bars (direction unknown) · range > " + str.tostring(bigCutW * 100, "#.##") + "%", alert.freq_once_per_bar_close)

// ═════════ table
posT = iPos == "Top right" ? position.top_right : iPos == "Top left" ? position.top_left : iPos == "Bottom right" ? position.bottom_right : position.bottom_left
tsz = iText == "Tiny" ? size.tiny : iText == "Normal" ? size.normal : size.small
var table T = table.new(posT, 2, 10, bgcolor=color.white, frame_color=#D9E0EB, frame_width=1, border_color=#E9EEF5, border_width=1)
ink = #0A1426
dim = #56657C
cell(r, a, b, col) =>
    table.cell(T, 0, r, a, text_color=dim, text_size=tsz, text_halign=text.align_left)
    table.cell(T, 1, r, b, text_color=col, text_size=tsz, text_halign=text.align_left)
px(x) => str.tostring(x, format.mintick)
if barstate.islast and iTable
    table.cell(T, 0, 0, "ULTRON RADAR", text_color=color.white, bgcolor=#1F5BFF, text_size=tsz)
    table.cell(T, 1, 0, mName + (exact ? " model" : " model (nearest, untested here)"), text_color=color.white, bgcolor=#1F5BFF, text_size=tsz)
    gTxt = gate == "L" ? "LOUD · big move likely" : gate == "Q" ? "QUIET · small move likely" : gate == "N" ? "NORMAL" : "warming up"
    cell(1, "Next 12 bars", gTxt, gate == "L" ? #1F5BFF : ink)
    cell(2, "Big / small move", "range > " + str.tostring(bigCutW * 100, "#.##") + "% / < " + str.tostring(smallCutW * 100, "#.##") + "%", ink)
    cell(3, "Right in testing", "LOUD " + array.get(G_PL, mi) + " · QUIET " + array.get(G_PQ, mi) + " (chance alone " + array.get(G_BASE, mi) + ")", ink)
    cell(4, "Direction", "not forecast: nobody can, reliably", dim)
    cell(5, "Trend chart / higher", (up1 ? "up" : dn1 ? "down" : "mixed") + " / " + (upH ? "up" : "not up"), up1 and upH ? cTarget : dn1 ? cStop : ink)
    cell(6, "Long stop / target", px(close - stopD) + " (-" + str.tostring(stopPct, "#.##") + "%) / " + px(close + iTargetR * stopD), ink)
    cell(7, "Fee cost", str.tostring(costR, "#.##") + "R · " + (costR <= 0.20 ? "OK" : costR <= 0.33 ? "costly: half size" : "too expensive: skip"), costR <= 0.20 ? cTarget : costR <= 0.33 ? ink : cStop)
    cell(8, "Size for " + str.tostring(iRisk) + "% risk", str.tostring(qty, "#.####") + " units ($" + str.tostring(qty * close, "#,###") + ")", ink)
    cell(9, "Not advice", "volatility, not direction", #97A3B6)
