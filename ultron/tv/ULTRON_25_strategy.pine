a14 = input.bool(true, "PULSAR · Bearish engulfing · 1h · big moves + uptrend · majors", group=gG)
a15 = input.bool(true, "QUASAR · Big green candle (momentum ignition) · 4h · big moves · majors", group=gG)
a16 = input.bool(true, "ZENITH · Outside bar, up close · 1h · big moves + uptrend · majors", group=gG)
a17 = input.bool(true, "AURORA · Inside bar breakdown · 1h · big moves + uptrend · majors", group=gG)
