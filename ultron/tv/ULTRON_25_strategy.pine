a21 = input.bool(true, "CEPHEUS · Breakout confirmed by OBV · 4h · big moves + uptrend · majors", group=gG)
a22 = input.bool(true, "ELARA · Breakout confirmed by OBV · 4h · big moves · majors", group=gG)
a23 = input.bool(true, "EOS · Donchian 20 breakout · 4h · big moves · majors", group=gG)
a24 = input.bool(true, "GAIA · Donchian 20 breakout · 4h · big moves + uptrend · majors", group=gG)
gD = "Display"
iTable = input.bool(true, "Show the council table", group=gD)
iTablePos = input.string("Top right", "Table position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=gD)
iTableSize = input.string("Small", "Table text", options=["Tiny", "Small", "Normal"], group=gD)
iPast = input.bool(true, "Mark past council buys", group=gD)
