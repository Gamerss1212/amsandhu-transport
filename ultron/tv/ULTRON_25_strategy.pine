// This source code is generated by ultron/tv/build_pine.py from the trained model. Educational, not advice.
// Trained 2026-10-03 04:43 UTC on Coinbase hourly data to 2026-10-02 01:00 UTC. 25 agents, one learned brain.
//@version=5
strategy("ULTRON 25 · AI trade council (strategy)", shorttitle="ULTRON 25", overlay=true, pyramiding=0, initial_capital=1000, default_qty_type=strategy.fixed, commission_type=strategy.commission.percent, commission_value=0.2, slippage=2, process_orders_on_close=false, calc_on_every_tick=false, max_labels_count=500, max_lines_count=500)

// ───────────────────────── inputs (change anything; the trained values are the defaults)
gA = "Account & risk"
iAccount = strategy.equity
iRiskMaj = input.float(0.60, "Risk per trade: BTC, ETH, SOL (%)", minval=0.05, maxval=5, step=0.05, group=gA)
iRiskMem = input.float(0.30, "Risk per trade: meme coins (%)", minval=0.05, maxval=5, step=0.05, group=gA)
gF = "Your exchange fees"
iMaker = input.float(0.20, "Maker fee per side (%)", minval=0, step=0.01, group=gF, tooltip="NDAX 0.20 · Kraken Pro entry tier 0.40 · Coinbase Advanced 0.60")
iTaker = input.float(0.20, "Taker fee per side (%)", minval=0, step=0.01, group=gF, tooltip="NDAX 0.20 · Kraken Pro entry tier 0.80 · Coinbase Advanced 1.20")
gB = "Brain (trained defaults)"
iTheta = input.float(-0.05, "Minimum learned edge (R)", step=0.01, group=gB, tooltip="The council approves a signal only if its learned edge minus caution x uncertainty is at least this.")
iZ = input.float(1.50, "Caution (x uncertainty)", minval=0, step=0.25, group=gB)
iGate = input.string("LOUD only (trained)", "Volatility filter", options=["LOUD only (trained)", "LOUD or NORMAL", "Off"], group=gB)
iCostMax = input.float(0.33, "Max fee cost (R)", minval=0.05, step=0.01, group=gB)
iStopMult = input.float(4.0, "Stop distance (x ATR of the agent's timeframe)", minval=0.5, step=0.25, group=gB)
iTargetR = input.float(2.0, "Target (R)", minval=0.5, step=0.25, group=gB)
iOrderBars = input.int(3, "Limit order valid (bars)", minval=1, group=gB)
iHold = input.int(96, "Max hold (hours)", minval=4, group=gB)
iOther = input.bool(false, "Also run on markets it was not trained on", group=gB)
gG = "The 25 agents (switch any off)"
a00 = input.bool(true, "ORION · Volume spike on a green candle · 4h · big moves + uptrend · majors", group=gG)
a01 = input.bool(true, "VEGA · Hanging man · 1h · big moves + uptrend · memes", group=gG)
