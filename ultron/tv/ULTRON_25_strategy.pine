iGateBg = input.bool(true, "Tint the background in LOUD periods", group=gD)
iMsg = input.string("Readable", "Alert message", options=["Readable", "JSON (for bots and webhooks)"], group=gD)
cBuy = input.color(color.new(#1F5BFF, 0), "Buy", group=gD, inline="c")
cStop = input.color(color.new(#E2474D, 0), "Stop", group=gD, inline="c")
cTarget = input.color(color.new(#0E9F63, 0), "Target", group=gD, inline="c")
cLoud = input.color(color.new(#1F5BFF, 93), "LOUD tint", group=gD, inline="c")

// ───────────────────────── trained constants
var string[] NAMES = array.from("ORION", "VEGA", "NOVA", "ATLAS", "LYRA", "TITAN", "AEGIS", "HELIOS", "SIRIUS", "KEPLER", "POLARIS", "RIGEL", "CYGNUS", "DRACO", "PULSAR", "QUASAR", "ZENITH", "AURORA", "BOREAS", "CALYPSO", "CASSINI", "CEPHEUS", "ELARA", "EOS", "GAIA")
var string[] LABELS = array.from("Volume spike on a green candle", "Hanging man", "Hammer", "Big green candle (momentum ignition)", "Spinning top", "Five green candles in a row", "Five green candles in a row", "Shooting star", "MFI above 80", "Volume spike on a green candle", "Close above the upper Bollinger band", "Doji after a drop", "Close above the upper Bollinger band", "MFI above 80", "Bearish engulfing", "Big green candle (momentum ignition)", "Outside bar, up close", "Inside bar breakdown", "OBV new high before price", "Doji after a rise", "Inside bar", "Breakout confirmed by OBV", "Breakout confirmed by OBV", "Donchian 20 breakout", "Donchian 20 breakout")
var int[] SIG = array.from(17, 8, 7, 2, 16, 6, 6, 15, 11, 17, 0, 3, 0, 11, 1, 2, 14, 10, 13, 4, 9, 12, 12, 5, 5)
var bool[] IS4H = array.from(true, false, false, true, false, true, true, false, true, true, true, false, true, true, false, true, false, false, false, false, false, true, true, true, true)
var int[] VARI = array.from(3, 3, 3, 3, 3, 3, 1, 1, 3, 1, 1, 3, 3, 1, 3, 1, 3, 3, 3, 3, 3, 3, 1, 1, 3)
var bool[] MAJ = array.from(true, false, false, true, true, false, false, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
var float[] M_BULL = array.from(0.51383, 0.49669, 0.51067, 0.33918, 0.47687, 0.43521, 0.42573, 0.4236, 0.43373, 0.50687, 0.43765, 0.46318, 0.4042, 0.45119, 0.36405, 0.35658, 0.34009, 0.42389, 0.39869, 0.4361, 0.3962, 0.31764, 0.35156, 0.32002, 0.29164)
var float[] S_BULL = array.from(0.12107, 0.15888, 0.14762, 0.09118, 0.08996, 0.13583, 0.12454, 0.14186, 0.11116, 0.10452, 0.09087, 0.10988, 0.10078, 0.10756, 0.10605, 0.07766, 0.12389, 0.11601, 0.12657, 0.10855, 0.0813, 0.08614, 0.08051, 0.07707, 0.08348)
var float[] M_BEAR = array.from(0.5615, 0.49675, 0.42873, 0.74765, 0.4764, 0.51205, 0.50334, 0.46668, 0.45414, 0.36144, 0.43671, 0.36727, 0.4616, 0.3791, 0.5534, 0.52415, 0.55401, 0.40916, 0.4352, 0.33535, 0.4014, 0.49475, 0.41885, 0.43816, 0.46281)
var float[] S_BEAR = array.from(0.12107, 0.15888, 0.14762, 0.09118, 0.08996, 0.13583, 0.12454, 0.14186, 0.11116, 0.10452, 0.09087, 0.10988, 0.10078, 0.10756, 0.10605, 0.07766, 0.12389, 0.11601, 0.12657, 0.10855, 0.0813, 0.08614, 0.08051, 0.07707, 0.08348)
var float[] M_NA = array.from(0.521, 0.48815, 0.47389, 0.47221, 0.4744, 0.45438, 0.4488, 0.43511, 0.43134, 0.43512, 0.43306, 0.42582, 0.42385, 0.41691, 0.42084, 0.42131, 0.41666, 0.41292, 0.40303, 0.3984, 0.39599, 0.3743, 0.37464, 0.36286, 0.34852)
var float[] S_NA = array.from(0.12107, 0.15888, 0.14762, 0.09118, 0.08996, 0.13583, 0.12454, 0.14186, 0.11116, 0.10452, 0.09087, 0.10988, 0.10078, 0.10756, 0.10605, 0.07766, 0.12389, 0.11601, 0.12657, 0.10855, 0.0813, 0.08614, 0.08051, 0.07707, 0.08348)
var float[] G_MU = array.from(0, -0.04035717, -0.15548584, -0.19200834, -0.12993081, -0.11763269, 1.58404434, 0.98695239, 0.00001015, -0.00020117, 0.28549648, -0.28392976, -0.05989721, -0.00949292)
var float[] G_SD = array.from(1, 0.31845712, 0.59096284, 0.64745282, 0.38362095, 0.50718507, 1.25696881, 0.52659623, 0.70711183, 0.7071017, 0.45165057, 0.55283779, 0.41001939, 0.48672306)
var float[] G_WL = array.from(-0.79240278, 0.77888342, 0.12517527, 0.00408937, -0.22210503, -0.1910334, 0.08122615, 0.13801996, 0.18562032, -0.2714689, -0.13867655, 0.02503302, 0.05023098, 0.01590603)
var float[] G_WQ = array.from(-0.65715546, -0.7879693, -0.15809324, 0.0662735, 0.24754194, 0.18897011, -0.07079198, -0.17524815, -0.17091167, 0.24656256, 0.26754159, -0.0559487, 0.01833281, 0.04452539)
G_TL = 0.621175
G_TQ = 0.63675
SIZE_A = 2
LOUD_PREC = "80%"

// ───────────────────────── market and timeframe
base = syminfo.basecurrency
isMajor = base == "BTC" or base == "ETH" or base == "SOL"
isMeme = base == "DOGE" or base == "SHIB" or base == "PEPE" or base == "BONK" or base == "WIF" or base == "FLOKI"
trained = isMajor or isMeme
useMajor = isMajor or (not isMeme and iOther)
active = (trained or iOther) and timeframe.period == "60"
slip = useMajor ? 0.0002 : 0.001
enabled = array.from(a00, a01, a02, a03, a04, a05, a06, a07, a08, a09, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24)

// ───────────────────────── the 18 signals (identical formulas on 1h and inside the 4h request)
f_dn(k) => close[k + 1] < close[k + 6]
f_up(k) => close[k + 1] > close[k + 6]
f_all() =>
    A = ta.atr(14)
    body = math.abs(close - open)
    rng = high - low
    upw = high - math.max(open, close)
    loww = math.min(open, close) - low
    isBull = close > open
    isBear = close < open
    big = rng >= 0.5 * A
    ham = loww >= 2 * body and upw <= 0.1 * rng and body >= 0.05 * rng and big
    inv = upw >= 2 * body and loww <= 0.1 * rng and body >= 0.05 * rng and big
    doji = body <= 0.1 * rng and big
    ins = high < high[1] and low > low[1]
    g5 = isBull and isBull[1] and isBull[2] and isBull[3] and isBull[4]
    r5 = isBear and isBear[1] and isBear[2] and isBear[3] and isBear[4]
    rvol = volume / ta.sma(volume, 20)[1]
    mf = ta.mfi(hlc3, 14)
    rsi14 = ta.rsi(close, 14)
    bbBasis = ta.sma(close, 20)
    bbDev = ta.stdev(close, 20)
    bbU = bbBasis + 2 * bbDev
    bbL = bbBasis - 2 * bbDev
    kcU = ta.ema(close, 20) + 2 * A
    ob = ta.obv
    obvHi = ob >= ta.highest(ob, 20)[1]
    cHi = close >= ta.highest(close, 20)[1]
    obvLead = obvHi and not cHi
    obvConf = obvHi and cHi
    don20 = close > ta.highest(high, 20)[1]
    upT = close > ta.ema(close, 50) and ta.ema(close, 21) > ta.ema(close, 50)
    s_bb_above = close > bbU and close[1] <= bbU[1]
    s_bear_engulfing = f_up(1) and isBull[1] and isBear and close <= open[1] and open >= close[1] and body > body[1]
    s_big_bull_bar = isBull and rng >= 2 * A[1] and body >= 0.6 * rng
    s_doji_after_drop = f_dn(0) and doji
    s_doji_after_rise = f_up(0) and doji
    s_donchian20 = don20 and not don20[1]
    s_five_green = g5 and not g5[1]
    s_hammer = f_dn(0) and ham
    s_hanging_man = f_up(0) and ham
    s_inside_bar = ins
    s_inside_bar_break_down = ins[1] and close < low[2]
    s_mfi_ob = mf > 80 and mf[1] <= 80
    s_obv_confirm = obvConf and not obvConf[1]
    s_obv_lead = obvLead and not obvLead[1]
    s_outside_bar_up = high > high[1] and low < low[1] and close > high[1]
    s_shooting_star = f_up(0) and inv
    s_spinning_top = body <= 0.3 * rng and body >= 0.1 * rng and upw >= body and loww >= body
    s_vol_spike_bull = rvol >= 3 and isBull and body >= 0.5 * rng
    [s_bb_above, s_bear_engulfing, s_big_bull_bar, s_doji_after_drop, s_doji_after_rise, s_donchian20, s_five_green, s_hammer, s_hanging_man, s_inside_bar, s_inside_bar_break_down, s_mfi_ob, s_obv_confirm, s_obv_lead, s_outside_bar_up, s_shooting_star, s_spinning_top, s_vol_spike_bull, A, upT]

[h_bb_above, h_bear_engulfing, h_big_bull_bar, h_doji_after_drop, h_doji_after_rise, h_donchian20, h_five_green, h_hammer, h_hanging_man, h_inside_bar, h_inside_bar_break_down, h_mfi_ob, h_obv_confirm, h_obv_lead, h_outside_bar_up, h_shooting_star, h_spinning_top, h_vol_spike_bull, atr1, upT1] = f_all()
[q_bb_above, q_bear_engulfing, q_big_bull_bar, q_doji_after_drop, q_doji_after_rise, q_donchian20, q_five_green, q_hammer, q_hanging_man, q_inside_bar, q_inside_bar_break_down, q_mfi_ob, q_obv_confirm, q_obv_lead, q_outside_bar_up, q_shooting_star, q_spinning_top, q_vol_spike_bull, atr4, up4now] = request.security(syminfo.tickerid, "240", f_all(), lookahead=barmerge.lookahead_off)
sig1 = array.from(h_bb_above, h_bear_engulfing, h_big_bull_bar, h_doji_after_drop, h_doji_after_rise, h_donchian20, h_five_green, h_hammer, h_hanging_man, h_inside_bar, h_inside_bar_break_down, h_mfi_ob, h_obv_confirm, h_obv_lead, h_outside_bar_up, h_shooting_star, h_spinning_top, h_vol_spike_bull)
sig4 = array.from(q_bb_above, q_bear_engulfing, q_big_bull_bar, q_doji_after_drop, q_doji_after_rise, q_donchian20, q_five_green, q_hammer, q_hanging_man, q_inside_bar, q_inside_bar_break_down, q_mfi_ob, q_obv_confirm, q_obv_lead, q_outside_bar_up, q_shooting_star, q_spinning_top, q_vol_spike_bull)
is4hEnd = hour(time, "UTC") % 4 == 3
var bool up4 = false
var float atr4L = na
if is4hEnd
    up4 := up4now
    atr4L := atr4

// ───────────────────────── trend and Bitcoin regime
up1 = ta.ema(close, 21) > ta.ema(close, 50) and close > ta.ema(close, 200)
upTrend = up1 and up4
f_btc() =>
    s200 = ta.sma(close, 200)
    r = na(s200) ? na : close > s200 ? 1.0 : 0.0
    r[1]
btcState = request.security("COINBASE:BTCUSD", "D", f_btc(), lookahead=barmerge.lookahead_on)

// ───────────────────────── the volatility gate (trained logistic model, 14 features)
lg(x) => math.log(math.max(1e-6, x))
lr = nz(math.log(close / close[1]))
rms(k) => math.sqrt(math.sum(lr * lr, k) / k)
bbw = 4 * ta.stdev(close, 20) / ta.sma(close, 20)
r12 = (ta.highest(high, 12) - ta.lowest(low, 12)) / close
r72 = (ta.highest(high, 72) - ta.lowest(low, 72)) / close
hr = hour(time, "UTC")
dw = dayofweek(time, "UTC")
vsd = ta.stdev(volume, 168)
feat = array.from(1.0, lg(atr1 / ta.sma(atr1, 168)), lg(bbw / ta.sma(bbw, 168)), lg((math.sum(volume, 6) / 6 + 1e-12) / (ta.sma(volume, 168) + 1e-12)), lg(rms(24) / rms(168)), lg(r12 / ta.sma(r12, 168)), math.min(6.0, math.abs(close - close[12]) / atr1), math.min(6.0, (high - low) / atr1), math.sin(2 * math.pi * hr / 24), math.cos(2 * math.pi * hr / 24), dw == dayofweek.saturday or dw == dayofweek.sunday ? 1.0 : 0.0, lg(rms(6) / rms(168)), lg(r72 / ta.sma(r72, 168)), math.max(-4.0, math.min(4.0, (ta.sma(volume, 24) - ta.sma(volume, 168)) / (vsd > 0 ? vsd : 1e-12))))
zl = 0.0
zq = 0.0
bad = bar_index < 248
for k = 0 to array.size(feat) - 1
    x = array.get(feat, k)
    if na(x)
        bad := true
    else
        zz = (x - array.get(G_MU, k)) / array.get(G_SD, k)
        zl += zz * array.get(G_WL, k)
        zq += zz * array.get(G_WQ, k)
pLoud = 1 / (1 + math.exp(-zl))
pQuiet = 1 / (1 + math.exp(-zq))
gate = bad ? "U" : pLoud >= G_TL ? "L" : pQuiet >= G_TQ ? "Q" : "N"
gateOk = iGate == "Off" ? gate != "U" : iGate == "LOUD or NORMAL" ? (gate == "L" or gate == "N") : gate == "L"

// ───────────────────────── the council: every enabled agent that fired asks the brain
var int[] last1 = array.new_int(18, -100000)
var int[] last4 = array.new_int(18, -100000)
keep1 = array.new_bool(18, false)
keep4 = array.new_bool(18, false)
for k = 0 to 17
    if array.get(sig1, k) and bar_index >= 210 and bar_index - array.get(last1, k) >= 12
        array.set(keep1, k, true)
        array.set(last1, k, bar_index)
    if is4hEnd and array.get(sig4, k) and bar_index - array.get(last4, k) >= 12
        array.set(keep4, k, true)
        array.set(last4, k, bar_index)
loud = gate == "L"
bestK = -1
bestScore = -1e9
bestM = 0.0
bestStop = 0.0
bestCost = 0.0
firing = 0
entryPx = close * 0.999
for k = 0 to 24
    s = array.get(SIG, k)
    four = array.get(IS4H, k)
    fired = four ? array.get(keep4, s) : array.get(keep1, s)
    v = array.get(VARI, k)
    cond = v == 0 or (v == 1 and loud) or (v == 2 and upTrend) or (v == 3 and loud and upTrend)
    if active and array.get(enabled, k) and array.get(MAJ, k) == useMajor and fired and cond
        firing += 1
        m = na(btcState) ? array.get(M_NA, k) : btcState == 1.0 ? array.get(M_BULL, k) : array.get(M_BEAR, k)
        se = na(btcState) ? array.get(S_NA, k) : btcState == 1.0 ? array.get(S_BULL, k) : array.get(S_BEAR, k)
        a = four ? atr4L : atr1
        stopD = iStopMult * a
        cost = ((iMaker + iTaker) / 100 + 2 * slip) / (stopD / entryPx)
        score = m - iZ * se
        if gateOk and not na(a) and cost <= iCostMax and score >= iTheta and score > bestScore
            bestScore := score
            bestK := k
            bestM := m
            bestStop := stopD
            bestCost := cost

// ───────────────────────── one plan per market: limit entry, stop, target, time limit
var float pEntry = na
var float pStop = na
var float pTarget = na
var int pBar = na
var int pFill = na
var string pAgent = ""
var float pSize = 0.0
var float pQty = 0.0
var line lE = na
var line lS = na
var line lT = na
buyNow = false
sellMsg = ""
riskPct = useMajor ? iRiskMaj : iRiskMem
busy = not na(pEntry)
if barstate.isconfirmed and bestK >= 0 and not busy
    buyNow := true
    sz = math.max(0.5, math.min(1.5, 1 + SIZE_A * bestM)) * (bestCost > 0.20 ? 0.5 : 1.0)
    pEntry := entryPx
    pStop := entryPx - bestStop
    pTarget := entryPx + iTargetR * bestStop
    pBar := bar_index
    pFill := na
    pAgent := array.get(NAMES, bestK)
    pSize := sz
    pQty := math.min(iAccount * riskPct / 100 * sz / bestStop, iAccount / entryPx)
    strategy.entry("ULTRON", strategy.long, qty=pQty, limit=pEntry, comment=pAgent)
    strategy.exit("EXIT", "ULTRON", stop=pStop, limit=pTarget)
    if iLines
        lE := line.new(bar_index, pEntry, bar_index + iHold, pEntry, color=cBuy, style=line.style_dashed, width=1)
        lS := line.new(bar_index, pStop, bar_index + iHold, pStop, color=cStop, style=line.style_dashed, width=1)
        lT := line.new(bar_index, pTarget, bar_index + iHold, pTarget, color=cTarget, style=line.style_dashed, width=1)
    if iPast
        label.new(bar_index, low, "BUY\n" + pAgent, style=label.style_label_up, color=cBuy, textcolor=color.white, size=size.small)
else if busy and barstate.isconfirmed and bar_index > pBar
    if na(pFill) and strategy.position_size > 0
        pFill := bar_index
    if na(pFill) and bar_index - pBar >= iOrderBars
        strategy.cancel("ULTRON")
        sellMsg := "CANCEL"
    else if not na(pFill)
        if bar_index - pFill >= iHold
            strategy.close("ULTRON", comment="96h")
            sellMsg := "TIME"
        if strategy.position_size == 0 and bar_index > pFill
            sellMsg := sellMsg == "" ? "DONE" : sellMsg
    if sellMsg != ""
        if iPast and sellMsg != "CANCEL" and sellMsg != "DONE"
            label.new(bar_index, high, "SELL\n" + sellMsg, style=label.style_label_down, color=sellMsg == "TARGET" ? cTarget : cStop, textcolor=color.white, size=size.small)
        pEntry := na
        pStop := na
        pTarget := na
        pFill := na

// ───────────────────────── alerts (create ONE alert: condition ULTRON 25 → "Any alert() function call")
if buyNow
    msgB = iMsg == "Readable" ? "ULTRON BUY " + syminfo.ticker + " · limit " + str.tostring(pEntry, format.mintick) + " · stop " + str.tostring(pStop, format.mintick) + " · sell " + str.tostring(pTarget, format.mintick) + " · size " + str.tostring(pQty, "#.####") + " · agent " + pAgent + " · edge " + (bestM >= 0 ? "+" : "") + str.tostring(bestM, "#.##") + "R" : '{"ultron":"BUY","symbol":"' + syminfo.ticker + '","agent":"' + pAgent + '","entry":' + str.tostring(pEntry, format.mintick) + ',"stop":' + str.tostring(pStop, format.mintick) + ',"target":' + str.tostring(pTarget, format.mintick) + ',"qty":' + str.tostring(pQty, "#.########") + ',"edge_r":' + str.tostring(bestM, "#.###") + ',"gate":"' + gate + '"}'
    alert(msgB, alert.freq_once_per_bar_close)
if sellMsg == "STOP" or sellMsg == "TARGET" or sellMsg == "TIME"
    why = sellMsg == "TARGET" ? "target reached" : sellMsg == "STOP" ? "stop-loss hit" : "96 hours are up"
    msgS = iMsg == "Readable" ? "ULTRON SELL " + syminfo.ticker + " now · " + why + " · price " + str.tostring(close, format.mintick) : '{"ultron":"SELL","symbol":"' + syminfo.ticker + '","reason":"' + sellMsg + '","price":' + str.tostring(close, format.mintick) + '}'
    alert(msgS, alert.freq_once_per_bar_close)

// ───────────────────────── chart
bgcolor(iGateBg and gate == "L" ? cLoud : na)
plotshape(buyNow and not iPast, "Council buy", shape.triangleup, location.belowbar, cBuy, size=size.tiny)
posT = iTablePos == "Top right" ? position.top_right : iTablePos == "Top left" ? position.top_left : iTablePos == "Bottom right" ? position.bottom_right : position.bottom_left
tsz = iTableSize == "Tiny" ? size.tiny : iTableSize == "Normal" ? size.normal : size.small
var table T = table.new(posT, 2, 10, bgcolor=color.new(color.white, 0), frame_color=color.new(#D9E0EB, 0), frame_width=1, border_color=color.new(#E9EEF5, 0), border_width=1)
cell(r, a, b, col) =>
    table.cell(T, 0, r, a, text_color=color.new(#56657C, 0), text_size=tsz, text_halign=text.align_left)
    table.cell(T, 1, r, b, text_color=col, text_size=tsz, text_halign=text.align_left)
if barstate.islast and iTable
    table.cell(T, 0, 0, "ULTRON 25", text_color=color.white, bgcolor=cBuy, text_size=tsz)
    table.cell(T, 1, 0, "AI TRADE COUNCIL", text_color=color.white, bgcolor=cBuy, text_size=tsz)
    if not active
        cell(1, "Status", timeframe.period != "60" ? "Use the 1-hour chart" : "Not trained on " + base, cStop)
    else
        gTxt = gate == "L" ? "LOUD (big move likely)" : gate == "Q" ? "QUIET" : gate == "N" ? "NORMAL" : "warming up"
        cell(1, "Volatility", gTxt, gate == "L" ? cBuy : color.new(#0A1426, 0))
        cell(2, "LOUD right (test)", LOUD_PREC, color.new(#0A1426, 0))
        cell(3, "Trend 1h / 4h", (up1 ? "up" : "no") + " / " + (up4 ? "up" : "no"), color.new(#0A1426, 0))
        cell(4, "Bitcoin regime", na(btcState) ? "n/a" : btcState == 1.0 ? "above 200-day" : "below 200-day", color.new(#0A1426, 0))
        cell(5, "Agents firing now", str.tostring(firing), color.new(#0A1426, 0))
        verdict = not na(pEntry) ? (na(pFill) ? "BUY ORDER WAITING" : "IN TRADE") : "WAIT"
        cell(6, "Council", verdict, not na(pEntry) ? cBuy : color.new(#56657C, 0))
        cell(7, "Plan", na(pEntry) ? "—" : "buy " + str.tostring(pEntry, format.mintick) + " · stop " + str.tostring(pStop, format.mintick) + " · sell " + str.tostring(pTarget, format.mintick), color.new(#0A1426, 0))
        cell(8, "Agent / size", na(pEntry) ? "—" : pAgent + " · " + str.tostring(pQty, "#.####") + " " + base, color.new(#0A1426, 0))
        cell(9, "Not advice", "paper-test before real money", color.new(#97A3B6, 0))
